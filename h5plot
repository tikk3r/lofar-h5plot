            elif self.poldifmode == PoldifMode.CROSS:
                self.select_label.setText('Corr.: {:s} - {:s}'.format(self.polarizations[1], self.polarizations[2]))
            return

    def _get_plot_colormap(self, isphase):
        if self.colormap_name is not None:
            colormap = get_colormap(self.colormap_name)
        elif isphase:
            colormap = get_phase_colormap()
        else:
            colormap = get_colormap('viridis')
        return copy.copy(colormap)

    def _colormap_picker_event(self, _index):
        self.colormap_name = self.colormap_picker.currentData()
        self.colormap_picker.setToolTip(
            'Cmap: {}'.format(self.colormap_name or 'Default'))
        if self.mode != 'values' or self.st.getType() not in ('phase', 'amplitude'):
            return
        colormap = self._get_plot_colormap(self.st.getType() == 'phase')
        colormap.set_bad(color='w')
        for axes in self.fig.axes:
            for image in axes.get_images():
                image.set_cmap(colormap)
        self.canvas.draw_idle()

    def _toggle_region_selection(self, enabled):
        if self.rectangle_selector is not None:
            self.rectangle_selector.set_active(enabled)
        for selector in self.grid_rectangle_selectors.values():
            selector.set_active(enabled)
        if not enabled:
            self._clear_selection()
            self.canvas.draw_idle()

    def _on_region_press(self, event):
        if event.xdata is None or event.ydata is None or event.inaxes is None:
            return
        if self.gridplot:
            for station_index, selector in self.grid_rectangle_selectors.items():
                if selector.ax == event.inaxes:
                    pending = self.grid_pending_regions.get(station_index)
                    if pending is None or self._press_is_inside(selector, event):
                        return
                    self.selected_regions.append((station_index, pending))
                    self.grid_pending_regions[station_index] = None
                    self._keep_marked_region(selector)
                    return
        else:
            if event.inaxes is not self.ax or self.selected_region is None or self.rectangle_selector is None:
                return
            if self._press_is_inside(self.rectangle_selector, event):
                return
            self.selected_regions.append(self.selected_region)
            self.selected_region = None
            self._keep_marked_region(self.rectangle_selector)

    def _on_region_selected(self, start_event, end_event):
        if start_event.xdata is None or start_event.ydata is None or end_event.xdata is None or end_event.ydata is None:
            return
        time_start, time_stop = image_cells_to_indices(
            min(start_event.xdata, end_event.xdata), max(start_event.xdata, end_event.xdata),
            self.plot_time_display_axis, self.plot_time_positions)
        freq_start, freq_stop = image_cells_to_indices(
            min(start_event.ydata, end_event.ydata), max(start_event.ydata, end_event.ydata),
            self.plot_freq_display_axis, self.plot_freq_positions)
        self.selected_region = (time_start, time_stop, freq_start, freq_stop)
        self.selected_station_index = self.antindex
        self.flag_button.setEnabled(True)

    def _on_grid_region_selected(self, start_event, end_event, station_index):
        if start_event.xdata is None or start_event.ydata is None or end_event.xdata is None or end_event.ydata is None:
            return
        time_edges = np.linspace(self.grid_time_axis[0], self.grid_time_axis[-1], len(self.grid_time_axis) + 1)
        freq_edges = np.linspace(self.grid_freq_axis[0], self.grid_freq_axis[-1], len(self.grid_freq_axis) + 1)
        time_start = int(np.searchsorted(time_edges, min(start_event.xdata, end_event.xdata), side='right') - 1)
        time_stop = int(np.searchsorted(time_edges, max(start_event.xdata, end_event.xdata), side='left'))
        freq_start = int(np.searchsorted(freq_edges, min(start_event.ydata, end_event.ydata), side='right') - 1)
        freq_stop = int(np.searchsorted(freq_edges, max(start_event.ydata, end_event.ydata), side='left'))
        time_start = max(0, min(time_start, len(self.grid_time_axis) - 1))
        time_stop = max(0, min(time_stop, len(self.grid_time_axis)))
        freq_start = max(0, min(freq_start, len(self.grid_freq_axis) - 1))
        freq_stop = max(0, min(freq_stop, len(self.grid_freq_axis)))
        if time_start < time_stop and freq_start < freq_stop:
            region = (time_start, time_stop, freq_start, freq_stop)
            self.grid_pending_regions[station_index] = region
            self.selected_station_index = station_index
            self.flag_button.setEnabled(True)

    def _flag_selected_region(self):
        self._update_selected_region_weights(0.0)

    def _flag_region(self, region, antenna, weight=0.0):
        self.parent.update_waterfall_weights(region, antenna, self.polslot, self.directions.index(self.direction), weight, self.propagate_directions.isChecked(), self.propagate_polarizations.isChecked(), self.propagate_antennas.isChecked(), dialog_parent=self)

    def _update_selected_region_weights(self, weight):
        if self.gridplot:
            regions = list(self.selected_regions)
            regions += [(station_idx, pending) for station_idx, pending in self.grid_pending_regions.items() if pending is not None]
        else:
            regions = [(self.antindex, region) for region in self.selected_regions]
            if self.selected_region is not None:
                regions.append((self.antindex, self.selected_region))
        if not regions:
            return
        with busy(self.status_label, 'Flagging, please wait...'):
            for antenna_index, region in regions:
                self._flag_region(region, antenna_index, weight)
            self._clear_selection()
            self._refresh_current_plot()

    def _flag_all_points(self):
        with busy(self.status_label, 'Flagging, please wait...'):
            if self.gridplot:
                region = (0, len(self.grid_time_axis), 0, len(self.grid_freq_axis))
                self._flag_region(region, self.selected_station_index)
            else:
                region = (0, len(self.plot_time_axis), 0, len(self.plot_freq_axis))
                self._flag_region(region, self.antindex)
            self._clear_selection()
            self._refresh_current_plot()

    def _load_current(self):
        """ Load the waterfall of the current antenna and direction, as a polarization difference if enabled. """
        direction_index = self.directions.index(self.direction)

        def load(pol):
            return load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, pol, direction=direction_index)

        if len(self.polarizations) > 1 and self.do_poldiff:
            pol_a, pol_b = (0, -1) if self.poldifmode == PoldifMode.PARALLEL else (1, 2)
            x, y, z1, zw1, isphase = load(pol_a)
            z2, zw2 = load(pol_b)[2:4]
            # Combine flags of both polarisations.
            return x, y, z1 - z2, zw1 * zw2, isphase
        return load(self.polslot)

    def _redraw(self):
        """ Redraw the current grid, or the waterfall of the current antenna. """
        with busy(self.status_label, 'Drawing, please wait...'):
            if self.gridplot:
                if self.nxm_dimensions is None:
                    self.plot_all()
                else:
                    self.plot_nxm(*self.nxm_dimensions)
                return
            x, y, z, zw, isphase = self._load_current()
            if self.mode == 'values':
                self.plot(x, y, np.where(zw, z, np.nan), self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'), isphase=isphase)
            else:
                self.plot(x, y, zw, self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'))

    def _refresh_current_plot(self):
        """ Redraw after flagging, keeping the zoom of a single waterfall. """
        if self.gridplot:
            self._redraw()
            return
        x_limits = self.ax.get_xlim()
        y_limits = self.ax.get_ylim()
        self._redraw()
        self.ax.set_xlim(x_limits)
        self.ax.set_ylim(y_limits)
        self.canvas.draw_idle()

    def _navigate_nxm_group(self, step):
        if self.nxm_dimensions is None:
            return False
        ncols, nrows = self.nxm_dimensions
        group_size = ncols * nrows
        last_station = len(self.stations) - 1
        self.antindex = max(0, min(self.antindex + step * group_size, last_station))
        self.frametitle = self.stations[self.antindex]
        self.plot_nxm(ncols, nrows)
        self.set_plot_window_title(self.frametitle)
        return True

    def _step_antenna(self, step):
        if self._navigate_nxm_group(step):
            return
        self.antindex = (self.antindex + step) % len(self.stations)
        self.frametitle = self.stations[self.antindex]
        self._redraw()
        self.set_plot_window_title(self.frametitle)

    def _step_direction(self, step):
        if len(self.directions) <= 1:
            return
        diridx = (self.directions.index(self.direction) + step) % len(self.directions)
        self.direction = self.directions[diridx]
        self._redraw()
        self.set_plot_window_title(self.frametitle)

    def _set_polslot(self, polslot):
        self.polslot = max(0, min(polslot, len(self.polarizations) - 1))
        self.button_prev.setEnabled(self.polslot > 0)
        self.button_next.setEnabled(self.polslot < len(self.polarizations) - 1)
        self.select_label.setText('Corr.: {:s}'.format(self.polarizations[self.polslot]))
        self._redraw()

    def _antiter_next_button_event(self):
        self._step_antenna(1)

    def _antiter_prev_button_event(self):
        self._step_antenna(-1)

    def _diriter_next_button_event(self):
        self._step_direction(1)

    def _diriter_prev_button_event(self):
        self._step_direction(-1)

    def _forward_button_event(self):
        """ An event triggered by pressing the "Next polarization" button. """
        self._set_polslot(self.polslot + 1)

    def _backward_button_event(self):
        """ An event triggered by pressing the "Previous polarization" button. """
        self._set_polslot(self.polslot - 1)

    def plot_all(self):
        self.nxm_dimensions = None
        Nplots = len(self.stations)
        Ncols = int(np.ceil(np.sqrt(Nplots)))
        Nrows = int(np.ceil(float(Nplots)/Ncols))
        station_indices = list(range(Nplots))
        self._plot_grid(station_indices, Ncols, Nrows)

    def plot_nxm(self, ncols, nrows):
        """Plot stations starting at the selected station in a fixed grid."""
        self.nxm_dimensions = (ncols, nrows)
        remaining_stations = len(self.stations) - self.antindex
        Nplots = min(remaining_stations, ncols * nrows)
        station_indices = list(range(self.antindex, self.antindex + Nplots))
        self._plot_grid(station_indices, ncols, nrows)

    def _station_slice(self, array, station_index, pol=None):
        """ Select the (time, freq) plane of a cached array for one station at the current polarization and direction. """
        index = [slice(None), slice(None), station_index]
        if 'pol' in self.cache_axes:
            index.append(self.polslot if pol is None else pol)
        if 'dir' in self.cache_axes:
            index.append(self.directions.index(self.direction))
        return array[tuple(index)]

    def _poldiff_pols(self):
        return (0, -1) if self.poldifmode == PoldifMode.PARALLEL else (1, 2)

    def _grid_weights(self, station_index):
        if self.do_poldiff and 'pol' in self.cache_axes:
            # A difference is only valid where both polarisations are unflagged.
            pol_a, pol_b = self._poldiff_pols()
            return self._station_slice(self.weights, station_index, pol_a) * self._station_slice(self.weights, station_index, pol_b)
        return self._station_slice(self.weights, station_index)

    def _grid_values(self, station_index, isphase):
        values = self.values[0]
        if self.do_poldiff and 'pol' in self.cache_axes:
            pol_a, pol_b = self._poldiff_pols()
            return self._station_slice(values, station_index, pol_a) - self._station_slice(values, station_index, pol_b)
        station_values = self._station_slice(values, station_index)
        if isphase:
            # Plot phase-like quantities w.r.t. the reference antenna.
            station_values = station_values - self._station_slice(values, self.refantindex)
        return station_values

    def _plot_grid(self, station_indices, Ncols, Nrows):
        if self.rectangle_selector is not None:
            self.rectangle_selector.disconnect_events()
            self.rectangle_selector = None
        for selector in self.grid_rectangle_selectors.values():
            selector.disconnect_events()
        self.grid_rectangle_selectors = {}
        # The figure is cleared below, which also removes the outlines of marked regions.
        self.selection_patches = []
        self._clear_selection()
        self.mark_region_button.setEnabled(True)
        self.flag_button.setEnabled(False)
        self.flag_all_button.setEnabled(False)
        self.propagate_polarizations.setEnabled(not self.do_poldiff)
        self.propagate_directions.setEnabled(True)
        self.propagate_antennas.setEnabled(True)
        self.fig.clf()
        self.gridplot = True
        isphase = self.st.getType() in ('phase', 'rotation')
        grid_bottom = 0.10
        grid_top = 0.95
        gs = GridSpec(Nrows, Ncols, figure=self.fig, left=0.05, right=0.95, bottom=grid_bottom, top=grid_top, hspace=0.04, wspace=0.025)
        global_limits = None
        if self.mode == 'values':
            global_limits = self.parent.get_global_limits()
        Nplots = len(station_indices)
        self.grid_time_axis = np.asarray(self.values[1]['time'])
        self.grid_time_axis = self.grid_time_axis - self.grid_time_axis[0]
        self.grid_freq_axis = np.asarray(self.values[1]['freq']) / 1e6
        self.fig.suptitle(self.st.name + ' - {:s}'.format(self.direction))
        Nplotted = 0
        for i in range(Nrows):
            for j in range(Ncols):
                if Nplotted >= Nplots:
                    continue
                station_index = station_indices[Nplotted]
                ax = self.fig.add_subplot(gs[i, j])
                ax.set_title(self.stations[station_index], y=1.0, pad=-15, color='white', fontweight='bold', path_effects=[patheffects.withStroke(linewidth=1, foreground="black")])
                x = self.values[1]['time']
                y = self.values[1]['freq'] / 1e6
                grid_weights = self._grid_weights(station_index).T
                if self.mode == 'values':
                    current_cmap = self._get_plot_colormap(isphase)
                    current_cmap.set_bad(color='w')
                    # Mask flagged solutions before differencing so the mask has the same shape as the data.
                    vals = np.where(grid_weights != 0, self._grid_values(station_index, isphase).T, np.nan)
                    if self.do_timediff:
                        vals = np.diff(vals, axis=1)
                    if self.do_freqdiff:
                        vals = np.diff(vals, axis=0)
                    if isphase:
                        vals = wrap_phase(vals)
                    vmin, vmax = global_limits if global_limits is not None else ((-np.pi, np.pi) if isphase else (0.5, 2.0))
                else:
                    current_cmap = get_colormap('viridis')
                    vals = grid_weights
                    vmin, vmax = 0.0, 1.0
                im = ax.imshow(vals, aspect='auto', extent=[0, x[-1]-x[0], y[0], y[-1]], interpolation='none', cmap=current_cmap, origin='lower', vmin=vmin, vmax=vmax)
                # Leave a margin, so a marked region can start just outside the first or last solution.
                x_span = x[-1] - x[0]
                y_span = y[-1] - y[0]
                x_padding = 0.02 * x_span if x_span else 0.02
                y_padding = 0.0325 * y_span if y_span else 0.0325
                ax.set_xlim(-x_padding, x[-1] - x[0] + x_padding)
                ax.set_ylim(y[0] - y_padding, y[-1] + y_padding)
                self.grid_rectangle_selectors[station_index] = RectangleSelector(
                    ax,
                    lambda start_event, end_event, station_index=station_index: self._on_grid_region_selected(start_event, end_event, station_index),
                    useblit=True,
                    button=[1],
                    spancoords='data',
                    interactive=True)
                self.grid_rectangle_selectors[station_index].set_active(self.mark_region_button.isChecked())
                if (Nplotted % Ncols):
                    ax.yaxis.set_visible(False)
                if (Nplotted < Nplots - Ncols):
                    ax.xaxis.set_visible(False)
                Nplotted += 1
        try:
            self.fig.supxlabel('Time [s]', y=0.02)
            self.fig.supylabel('Frequency [MHz]', x=0.01)
        except AttributeError:
            self.LOGGER.warning('Setting labels with supxlabel/supylabel failed, not plotting axes labels. You may need to updated matplotlib to >3.4.')
        cbar_ax = self.fig.add_axes([0.955, grid_bottom, 0.015, grid_top - grid_bottom])
        self.fig.colorbar(im, cax=cbar_ax)
        if not self.isVisible():
            self.setWindowState(QtCore.Qt.WindowMaximized)
        self.btn_antiter_prev.setEnabled(self.nxm_dimensions is not None and self.antindex > 0)
        self.btn_antiter_next.setEnabled(
            self.nxm_dimensions is not None
            and self.antindex + Ncols * Nrows < len(self.stations))
        self.canvas.draw_idle()


    def plot(self, xaxis, yaxis, zaxis, frametitle='', limits=(None, None), ax_labels=('', ''), multidim=False, isphase=False):
        for selector in self.grid_rectangle_selectors.values():
            selector.disconnect_events()
        self.grid_rectangle_selectors = {}
        self.gridplot = False
        self.mark_region_button.setEnabled(True)
        self.flag_all_button.setEnabled(True)
        self.propagate_polarizations.setEnabled(not self.do_poldiff)
        self.propagate_directions.setEnabled(True)
        self.propagate_antennas.setEnabled(True)
        self.xlabel = ax_labels[0]
        self.ylabel = ax_labels[1]
        self.fig.clf()
        self.ax = self.fig.add_subplot(111)
        self.ax.clear()
        self.selected_regions = []
        self.selection_patches = []
        self.grid_pending_regions = {}
        if self.rectangle_selector is not None:
            self.rectangle_selector.disconnect_events()
        self.rectangle_selector = RectangleSelector(self.ax, self._on_region_selected, useblit=True, button=[1], spancoords='data', interactive=True)
        self.rectangle_selector.set_active(self.mark_region_button.isChecked())
        self.selected_region = None
        self.flag_button.setEnabled(False)
        # Store the exact displayed axes so rectangle coordinates map directly to data indices.
        self.plot_time_axis = np.asarray(xaxis) - xaxis[0]
        self.plot_freq_axis = np.asarray(yaxis) * 1e-6
        xaxis = self.plot_time_axis
        yaxis = self.plot_freq_axis
        if self.polarizations is not None:
            if self.do_poldiff:
                if self.poldifmode == PoldifMode.PARALLEL:
                    pol = '{:s} - {:s}'.format(self.polarizations[0], self.polarizations[-1])
                elif self.poldifmode == PoldifMode.CROSS:
                    pol = '{:s} - {:s}'.format(self.polarizations[1], self.polarizations[2])
            else:
                pol = self.polarizations[self.polslot]
            self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s}'.format(pol, self.direction))
            if self.do_timediff and not self.do_freqdiff:
                self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s} time diff'.format(pol, self.direction))
            if not self.do_timediff and self.do_freqdiff:
                self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s} frequency diff'.format(pol, self.direction))
            if self.do_timediff and self.do_freqdiff:
                self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s} time and frequency diff'.format(pol, self.direction))
        else:
            self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s}'.format(self.direction))
        vals = np.ma.filled(np.ma.asarray(zaxis, dtype=float), np.nan)
        # Pad gaps in irregular axes with NaNs. The positions record where each solution ends up in the
        # displayed image, so selected regions can be mapped back to solution indices.
        plot_x, self.plot_time_positions = pad_axis_gaps(xaxis)
        plot_y, self.plot_freq_positions = pad_axis_gaps(yaxis)
        if len(plot_x) != len(xaxis) or len(plot_y) != len(yaxis):
            self.LOGGER.warning('Found irregular time or frequency axis, padding gaps with NaNs...')
            padded_vals = np.full((len(plot_x), len(plot_y)), np.nan)
            padded_vals[np.ix_(self.plot_time_positions, self.plot_freq_positions)] = vals
            vals = padded_vals
        self.plot_time_display_axis = plot_x
        self.plot_freq_display_axis = plot_y
        if self.do_timediff:
            vals = np.diff(vals, axis=0)
            if self.st.getType() == 'phase':
                vals = wrap_phase(vals)
        if self.do_freqdiff:
            vals = np.diff(vals, axis=1)
            if self.st.getType() == 'phase':
                vals = wrap_phase(vals)
        if isphase:
            vals = wrap_phase(vals)
            current_cmap = self._get_plot_colormap(True)
            current_cmap.set_bad(color='w')
            im = self.ax.imshow(vals.T, interpolation='none', extent=[plot_x[0], plot_x[-1], plot_y[0], plot_y[-1]], aspect='auto', cmap=current_cmap, origin='lower')
            global_limits = None
            if self.mode == 'values' and self.parent is not None:
                global_limits = self.parent.get_global_limits()
            if global_limits is not None:
                im.set_clim(global_limits[0], global_limits[1])
            else:
                im.set_clim(-np.pi, np.pi)
        else:
            current_cmap = self._get_plot_colormap(False)
            current_cmap.set_bad(color='w')
            im = self.ax.imshow(vals.T, interpolation='none', extent=[plot_x[0], plot_x[-1], plot_y[0], plot_y[-1]], aspect='auto', cmap=current_cmap, origin='lower')
            if self.mode == 'values' and self.parent is not None:
                global_limits = self.parent.get_global_limits()
                if global_limits is not None:
                    im.set_clim(global_limits[0], global_limits[1])
        self.fig.subplots_adjust(right=0.89)
        axes_position = self.ax.get_position()
        colorbar_ax = self.fig.add_axes([
            axes_position.x1 + 0.035,
            axes_position.y0,
            0.015,
            axes_position.height])
        self.fig.colorbar(im, cax=colorbar_ax)
        self.ax.set(xlabel=ax_labels[0], ylabel=ax_labels[1], xlim=limits[0], ylim=limits[1])
        if limits[0] is None:
            x_span = plot_x[-1] - plot_x[0]
            x_padding = 0.02 * x_span if x_span else 0.02
            self.ax.set_xlim(plot_x[0] - x_padding, plot_x[-1] + x_padding)
        if limits[1] is None:
            y_span = plot_y[-1] - plot_y[0]
            y_padding = 0.0325 * y_span if y_span else 0.0325
            self.ax.set_ylim(plot_y[0] - y_padding, plot_y[-1] + y_padding)
        self.canvas.draw_idle()


class ListWidget(QListWidget):
    """ Version of QListWidget that resizes itself.
    
    https://stackoverflow.com/questions/63497841/qlistwidget-does-not-resize-itself
    """
    INITIAL_HEIGHT = 300

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)
        self.setSizeAdjustPolicy(QtWidgets.QAbstractScrollArea.AdjustToContents)


    def minimumSizeHint(self) -> QtCore.QSize:
        return QtCore.QSize(-1, -1)


    def viewportSizeHint(self) -> QtCore.QSize:
        if self.model().rowCount() == 0:
            return QtCore.QSize(self.width(), 0)
        height = sum(self.sizeHintForRow(i) for i in range(self.count()) if not self.item(i).isHidden())
        width = super().viewportSizeHint().width()
        return QtCore.QSize(width, min(height, self.INITIAL_HEIGHT))



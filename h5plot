    def _global_limits_toggle_event(self):
        enabled = self.check_global_values.isChecked() and (self.plotmode == 'values')
        self.global_min_label.setEnabled(enabled)
        self.global_max_label.setEnabled(enabled)
        self.global_min_input.setEnabled(enabled)
        self.global_max_input.setEnabled(enabled)

    def _decode_axis_label(self, value):
        try:
            return value.decode('utf-8')
        except AttributeError:
            return str(value)

    def _is_phase_soltab(self):
        stype = self.soltab.getType().lower()
        sname = self.soltab.name.lower()
        return (stype in ['phase', 'rotation']) or ('phase' in sname)

    def _is_amplitude_soltab(self):
        stype = self.soltab.getType().lower()
        sname = self.soltab.name.lower()
        return (stype == 'amplitude') or ('amplitude' in sname)

    def _collect_amplitude_reference_values(self):
        values = np.asarray(self.stcache.values[0])
        weights = np.asarray(self.stcache.weights)
        axes = list(self.stcache.axes)

        if 'pol' not in axes:
            valid = np.isfinite(values) & np.isfinite(weights) & (weights > 0)
            return values[valid]

        pol_axis = axes.index('pol')
        pol_values = [self._decode_axis_label(p).upper() for p in self.stcache.values[1]['pol']]

        def select_pol(pol_idx):
            vals = np.take(values, indices=pol_idx, axis=pol_axis)
            wts = np.take(weights, indices=pol_idx, axis=pol_axis)
            valid = np.isfinite(vals) & np.isfinite(wts) & (wts > 0)
            return vals[valid]

        if ('XX' in pol_values) and ('YY' in pol_values):
            xx = select_pol(pol_values.index('XX'))
            yy = select_pol(pol_values.index('YY'))
            return np.concatenate((xx, yy))

        if 'I' in pol_values:
            return select_pol(pol_values.index('I'))

        valid = np.isfinite(values) & np.isfinite(weights) & (weights > 0)
        return values[valid]

    def _compute_default_global_limits(self):
        if self._is_phase_soltab():
            return -np.pi, np.pi

        if self._is_amplitude_soltab():
            ampvals = self._collect_amplitude_reference_values()
            if ampvals.size > 0:
                med = np.nanmedian(ampvals)
                if np.isfinite(med) and med > 0:
                    return med / 2.5, med * 2.5
            return 0.5, 2.0

        vals = np.asarray(self.stcache.values[0])
        wts = np.asarray(self.stcache.weights)
        valid = np.isfinite(vals) & np.isfinite(wts) & (wts > 0)
        if np.any(valid):
            data = vals[valid]
            return np.nanpercentile(data, 1), np.nanpercentile(data, 99)
        return 0.0, 1.0

    def _update_global_limit_defaults(self):
        vmin, vmax = self._compute_default_global_limits()
        self.global_min_input.setText('{:.6g}'.format(vmin))
        self.global_max_input.setText('{:.6g}'.format(vmax))

    def get_global_limits(self):
        if not self.check_global_values.isChecked():
            return None
        try:
            vmin = float(self.global_min_input.text())
            vmax = float(self.global_max_input.text())
        except ValueError:
            self.logger.warning('Invalid global limits entered, ignoring.')
            return None
        if not np.isfinite(vmin) or not np.isfinite(vmax):
            self.logger.warning('Global limits are not finite, ignoring.')
            return None
        if vmin >= vmax:
            self.logger.warning('Global min >= max, ignoring global limits.')
            return None
        return vmin, vmax

    def _get_flagged_h5parm(self, dialog_parent=None):
        if self.flagged_h5parm is None:
            if self.check_overwrite.isChecked():
                fig_soltabs = []
                for fig in self.figures:
                    s_name = getattr(fig, 'solset_name', self.solset.name)
                    t_name = getattr(fig, 'st_name', getattr(getattr(fig, 'st', None), 'name', None))
                    fig_soltabs.append((fig, s_name, t_name))

                if self.h5parm is not None:
                    try:
                        self.h5parm.close()
                    except Exception:
                        pass
                self.flagged_h5file = self.source_h5file
                self.flagged_h5parm = lh5.h5parm(self.source_h5file, readonly=False)
                self.h5parm = self.flagged_h5parm
                self.solset = self.h5parm.getSolset(self.solset_picker.currentText())
                self.soltab = self.solset.getSoltab(self.soltab_picker.currentText())
                self.check_overwrite.setEnabled(False)

                for fig, s_name, t_name in fig_soltabs:
                    if t_name is not None:
                        try:
                            new_st = self.h5parm.getSolset(s_name).getSoltab(t_name)
                            fig.st = new_st
                            fig.st_name = new_st.name
                        except Exception:
                            pass

                self.logger.info('Opened original HDF5 file for overwriting: %s', self.source_h5file)
            else:
                output_file = os.path.splitext(self.source_h5file)[0] + '_flagged.h5'
                if os.path.exists(output_file):
                    answer = QtWidgets.QMessageBox.question(
                        dialog_parent if dialog_parent is not None else self,
                        'Overwrite flagged file?',
                        'The flagged file already exists:\n{}\n\nOverwrite it?'.format(output_file),
                        QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                        QtWidgets.QMessageBox.No)
                    if answer != QtWidgets.QMessageBox.Yes:
                        return None
                self.logger.info('Copying %s to %s for flagging, this can take a while for large files.', self.source_h5file, output_file)
                status_label = getattr(dialog_parent, 'status_label', None) or self.status_label
                with busy(status_label, 'Copying the H5parm to {} for flagging, this can take a while for large files...'.format(os.path.basename(output_file))):
                    shutil.copy2(self.source_h5file, output_file)
                self.flagged_h5file = output_file
                self.flagged_h5parm = lh5.h5parm(output_file, readonly=False)
                self.check_overwrite.setEnabled(False)
                self.logger.info('Created writable flagging copy %s', output_file)
        return self.flagged_h5parm

    def update_waterfall_weights(self, region, antenna, polslot, direction, weight, propagate_directions=True, propagate_polarizations=True, propagate_antennas=False, dialog_parent=None):
        """Update weights in the flagging copy for a selected time-frequency region.

        The soltab, cached weights and polarization difference mode are taken from `dialog_parent` when given,
        so flags always end up in the soltab of the window they were made in.
        """
        time_start, time_stop, freq_start, freq_stop = region
        if time_start >= time_stop or freq_start >= freq_stop:
            self.logger.warning('Selected region does not contain any solutions: time %d:%d, frequency %d:%d.', time_start, time_stop, freq_start, freq_stop)
            return
        if dialog_parent is not None and getattr(dialog_parent, 'st_name', None) is not None:
            solset_name = dialog_parent.solset_name
            soltab_name = dialog_parent.st_name
            cache_weights = dialog_parent.weights
            cache_axes = dialog_parent.cache_axes
            do_poldiff = dialog_parent.do_poldiff
            poldifmode = dialog_parent.poldifmode
        else:
            solset_name = self.solset.name
            soltab_name = self.soltab.name
            cache_weights = self.stcache.weights
            cache_axes = list(self.stcache.axes)
            do_poldiff = self.do_poldiff
            poldifmode = self.poldifmode
        target_h5parm = self._get_flagged_h5parm(dialog_parent=dialog_parent)
        if target_h5parm is None:
            return
        target_soltab = target_h5parm.getSolset(solset_name).getSoltab(soltab_name)
        soltab_axes = list(target_soltab.getAxesNames())

        if propagate_antennas and 'ant' in soltab_axes:
            antenna_indices = list(range(target_soltab.getAxisLen('ant')))
        else:
            antenna_indices = [antenna]

        if propagate_polarizations and 'pol' in soltab_axes:
            polarization_indices = list(range(target_soltab.getAxisLen('pol')))
        elif do_poldiff and poldifmode == PoldifMode.PARALLEL:
            polarization_indices = [0, -1]
        elif do_poldiff and poldifmode == PoldifMode.CROSS:
            polarization_indices = [1, 2]
        elif polslot is None:
            polarization_indices = [0]
        else:
            polarization_indices = [polslot]
        if 'pol' in soltab_axes:
            polarization_indices = [p % target_soltab.getAxisLen('pol') for p in polarization_indices]

        if propagate_directions and 'dir' in soltab_axes:
            direction_indices = list(range(target_soltab.getAxisLen('dir')))
        else:
            direction_indices = [direction]

        axis_indices = {
            'time': slice(time_start, time_stop),
            'freq': slice(freq_start, freq_stop),
            'ant': indices_to_selection(antenna_indices),
            'pol': indices_to_selection(polarization_indices),
            'dir': indices_to_selection(direction_indices),
        }
        for selection in iterate_selections(soltab_axes, axis_indices):
            target_soltab.setValues(weight, selection=selection, weight=True)
        self._record_flag(target_soltab, solset_name, soltab_name, region, antenna_indices if not (propagate_antennas and 'ant' in soltab_axes) else None, polarization_indices, direction_indices)

        # Update every cached copy of this soltab's weights: the window's, the main window's and other open windows'.
        weight_caches = [(cache_weights, cache_axes)]
        if (solset_name, soltab_name) == self.loaded_soltab:
            weight_caches.append((self.stcache.weights, list(self.stcache.axes)))
        for plot_window in self.figures:
            if (getattr(plot_window, 'solset_name', None), getattr(plot_window, 'st_name', None)) == (solset_name, soltab_name):
                weight_caches.append((plot_window.weights, plot_window.cache_axes))
        updated = set()
        for weights, axes in weight_caches:
            if id(weights) in updated:
                continue
            updated.add(id(weights))
            for selection in iterate_selections(axes, axis_indices):
                weights[tuple(selection)] = weight

        for plot_window in self.figures:
            if plot_window is dialog_parent or not isinstance(plot_window, GraphWindow2D) or not plot_window.isVisible() or not plot_window.gridplot:
                continue
            if (plot_window.solset_name, plot_window.st_name) != (solset_name, soltab_name):
                continue
            if plot_window.nxm_dimensions is None:
                plot_window.plot_all()
            else:
                plot_window.plot_nxm(*plot_window.nxm_dimensions)
        self.logger.info('Updated waterfall weights of %s/%s in %s', solset_name, soltab_name, self.flagged_h5file)

    def _record_flag(self, soltab, solset_name, soltab_name, region, antenna_indices, polarization_indices, direction_indices):
        """ Remember a flag action, to write it to a DP3 parset later.

        Args:
            soltab (Soltab): the soltab that was flagged.
            solset_name (str): name of its solset.
            soltab_name (str): name of the soltab.
            region (tuple): (time_start, time_stop, freq_start, freq_stop) solution indices.
            antenna_indices (list or None): flagged antennas, None for all antennas.
            polarization_indices (list): flagged polarizations.
            direction_indices (list): flagged directions.
        """
        axes = soltab.getAxesNames()

        def axis_names(axis, indices):
            if axis not in axes:
                return None
            values = soltab.getAxisValues(axis)
            return [str(values[i]) for i in indices]

        time_start, time_stop, freq_start, freq_stop = region
        self.flag_history.append({
            'solset': solset_name,
            'soltab': soltab_name,
            'region': region,
            'stations': axis_names('ant', antenna_indices) if antenna_indices is not None else None,
            'time': solution_range(soltab.getAxisValues('time') if 'time' in axes else None, time_start, time_stop),
            'freq': solution_range(soltab.getAxisValues('freq') if 'freq' in axes else None, freq_start, freq_stop),
            'pols': axis_names('pol', polarization_indices),
            'dirs': axis_names('dir', direction_indices),
        })
        self.save_parset_button.setEnabled(True)

    def write_dp3_parset(self, path):
        """ Write the flags made so far as a DP3 flagging parset. """
        text = make_dp3_parset(self.flag_history, os.path.basename(path), self.source_h5file, self.flagged_h5file)
        with open(path, 'w') as parset:
            parset.write(text)
        self.logger.info('Wrote DP3 flagging parset %s for %d flag actions.', path, len(self.flag_history))

    def _choose_parset_path(self):
        """ Return where to save the DP3 parset, asking the user if the default file exists. None if cancelled. """
        default_path = os.path.join(os.getcwd(), os.path.splitext(self.h5filename)[0] + '_DP3_preflag.parset')
        if not os.path.exists(default_path):
            return default_path
        box = QtWidgets.QMessageBox(self)
        box.setIcon(QtWidgets.QMessageBox.Question)
        box.setWindowTitle('DP3 parset exists')
        box.setText('The DP3 parset already exists:\n{}\n\nOverwrite it, or save under a new file name?'.format(default_path))
        overwrite_button = box.addButton('Overwrite', QtWidgets.QMessageBox.AcceptRole)
        save_as_button = box.addButton('Save as...', QtWidgets.QMessageBox.ActionRole)
        box.addButton(QtWidgets.QMessageBox.Cancel)
        exec_dialog(box)
        if box.clickedButton() is overwrite_button:
            return default_path
        if box.clickedButton() is save_as_button:
            path, _ = QtWidgets.QFileDialog.getSaveFileName(self, 'Save DP3 parset', default_path, 'Parset files (*.parset);;All files (*)')
            return path or None
        return None

    def _save_parset_button_event(self):
        if not self.flag_history:
            return
        path = self._choose_parset_path()
        if path is None:
            return
        self.write_dp3_parset(path)
        QtWidgets.QMessageBox.information(
            self, 'DP3 parset saved',
            'Saved the flags as a DP3 parset:\n{}\n\nApply them to a Measurement Set with:\n    DP3 {} msin=<your.ms>'.format(path, os.path.basename(path)))

    def plot_waterfall(self, labels=('x-axis', 'y-axis'), mode='values', plot_all=False, nxm=None):
        """ Show a two-dimensional waterfall plot of time vs. frequency.
        """
        if ('phase_offset') in self.soltab.name:
            self.logger.info('Phase-offset is scalar and cannot be plotted in 2D.')
        if (('rotationmeasure' in self.soltab.name) or ('RMextract' in self.soltab.name) or ('clock' in self.soltab.name) or ('faraday' in self.soltab.name) or ('tec' in self.soltab.name)):
            self.logger.info('Rotation Measure, clock, faraday or TEC cannot be plotted in 2D!')
            return
        self.logger.info('Plotting ' + self.soltab.name + \
                         ' for ' + self.solset.name)
        antenna = self.station_picker.currentRow()
        # Data loaded here is xaxis, yaxis, zaxis, isphase
        try:
            if self.polarizations is not None:
                if len(self.polarizations) > 1 and self.do_poldiff:
                    if self.poldifmode == PoldifMode.PARALLEL:
                        # Need to plot polarisation difference.
                        x, y, z1, zw1, p = load_axes_2d(self.stcache.values, self.stcache.weights, self.soltab, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), pol=0, direction=self.direction)
                        x2, y2, z2, zw2, p2 = load_axes_2d(self.stcache.values, self.stcache.weights, self.soltab, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), pol=-1, direction=self.direction)
                    elif self.poldifmode == PoldifMode.CROSS:
                        # Need to plot polarisation difference.
                        x, y, z1, zw1, p = load_axes_2d(self.stcache.values, self.stcache.weights, self.soltab, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), pol=1, direction=self.direction)
                        x2, y2, z2, zw2, p2 = load_axes_2d(self.stcache.values, self.stcache.weights, self.soltab, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), pol=2, direction=self.direction)
                    z = z1 - z2
                    # Combine flags of both polarisations.
                    zw = zw1 * zw2
                else:
                    x, y, z, zw, p = load_axes_2d(self.stcache.values, self.stcache.weights, self.soltab, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), pol=0, direction=self.direction)
            else:
                x, y, z, zw, p = load_axes_2d(self.stcache.values, self.stcache.weights, self.soltab, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), pol=0, direction=self.direction)
        except ValueError:
            logging.error('Error loading 2D data!')
            return
        if (len(x) == 1) or (len(y) == 1):
            self.logger.info('Either time or frequency has only 1 entry, not plotting!')
            return
        # Blank flagged solutions, so they also drop out of differences with the reference antenna.
        # This is done in place, as the array can be very large.
        if np.issubdtype(self.stcache.values[0].dtype, np.floating):
            self.stcache.values[0][self.stcache.weights == 0] = np.nan
        pols = self.polarizations if self.polarizations is not None else ['N/A']
        plot_window = GraphWindow2D(self.stcache.values, self.stcache.weights, self.stations[antenna], antenna, np.argwhere(self.stations == self.refant).item(), self.axis, self.soltab, times=self.times, freqs=self.frequencies, pols=pols, parent=self, direction=self.directions[self.direction], mode=mode, do_timediff=self.check_tdiff.isChecked(), do_freqdiff=self.check_fdiff.isChecked(), do_poldiff=self.do_poldiff, poldifmode=self.poldifmode)
        self.figures.append(plot_window)
        if nxm is None and not plot_all:
            plot_window.fig.set_size_inches(
                plot_window.fig.get_figwidth() * 0.5,
                plot_window.fig.get_figheight() * 0.5,
                forward=True)
        if nxm is not None:
            plot_window.plot_nxm(*nxm)
        elif plot_all:
            plot_window.plot_all()
        else:
            if mode == 'values':
                zm = np.ma.masked_where(zw == 0, z)
                plot_window.plot(x, y, zm, ax_labels=('Time [s]', 'Freq. [MHz]'), isphase=p, frametitle=self.stations[antenna])
            elif mode == 'weights':
                plot_window.plot(x, y, zw, ax_labels=('Time [s]', 'Freq. [MHz]'), frametitle=self.stations[antenna])

        if nxm is None and not plot_all:
            plot_window.layout.setSizeConstraint(QtWidgets.QLayout.SetNoConstraint)
            screen_geometry = QApplication.primaryScreen().availableGeometry()
            plot_window.resize(
                int(screen_geometry.width() * 0.565),
                int(screen_geometry.height() * 0.73))
        plot_window.show()

    def plot(self, labels=('x-axis', 'y-axis'), limits=([None, None], [None, None]), mode='values', plot_all=False):
        if ('phase_offset') in self.soltab.name:
            self.logger.info('Phase-offset is scalar and cannot be plotted in 2D.')
        self.logger.info('Plotting ' + self.soltab.name + ' vs ' + self.axis + \
                         ' for ' + self.solset.name)
        antenna = self.station_picker.currentRow()
        if (('rotationmeasure' in self.soltab.name) or ('RMextract' in self.soltab.name) or ('clock' in self.soltab.name) or ('faraday' in self.soltab.name) or ('tec' in self.soltab.name)) and (self.axis == 'freq'):
            self.logger.info('Rotation Measure or clock does not support frequency axis! Switch to time instead.')
            return
        msg = load_axes(self.stcache.values, self.soltab, self.axis, antenna=antenna, refantenna=np.argwhere(self.stations == self.refant).item(), direction=self.direction, weights=self.stcache.weights)
        try:
            x_axis, Y_AXIS, Y_AXIS_WEIGHT, plabels, isphase = msg
        except ValueError:
            # Requested combination not supported.
            return
        if 'freq' in self.soltab.getAxesNames():
            plot_window = GraphWindow(self.stcache.values, self.stcache.weights, self.stations[antenna], antenna, np.argwhere(self.stations == self.refant).item(), self.axis, self.soltab, times=self.times, freqs=self.frequencies, parent=self, direction=self.directions[self.direction], mode=mode, do_timediff=self.check_tdiff.isChecked(), do_freqdiff=self.check_fdiff.isChecked(), do_poldiff=self.do_poldiff, poldifmode=self.poldifmode)
        else:
            # Probably TEC or another solution type with no frequency axis.
            plot_window = GraphWindow(self.stcache.values, self.stcache.weights, self.stations[antenna], antenna, np.argwhere(self.stations == self.refant).item(), self.axis, self.soltab, times=self.times, parent=self, direction=self.directions[self.direction], mode=mode, do_timediff=self.check_tdiff.isChecked(), do_freqdiff=self.check_fdiff.isChecked(), do_poldiff=self.do_poldiff, poldifmode=self.poldifmode)
        self.figures.append(plot_window)
        plot_window.plot(x_axis, Y_AXIS, Y_AXIS_WEIGHT, self.stations[antenna], limits=[None, None], ax_labels=[self.axis, labels[1]], plot_labels=plabels, isphase=isphase)
        plot_window.show()

        # TEC does not have a frequency axis, so disable the button as well.
        if 'tec' in self.soltab.name:
            self.logger.debug('TEC solutions detected, disabling buttons.')
            plot_window.button_next.setEnabled(False)
            plot_window.button_prev.setEnabled(False)
        if self.axis.lower() == 'freq' and (len(self.times) == 1):
            plot_window.button_next.setEnabled(False)
            self.logger.debug('Single time slot detected, disabling buttons.')
        elif self.axis.lower() == 'freq' and (len(self.times) > 1):
            self.logger.debug('Multiple time slots detected, enabling buttons.')
            plot_window.button_next.setEnabled(True)
        if self.axis.lower() == 'time' and (self.frequencies is None or (len(self.frequencies) == 1)):
            plot_window.button_next.setEnabled(False)
            self.logger.debug('Single frequency slot detected, disabling buttons.')
        elif self.axis.lower() == 'time' and (len(self.frequencies) > 1):
            self.logger.debug('Multiple frequency slots detected, enabling buttons.')
            plot_window.button_next.setEnabled(True)


class SoltabCache:
    '''Simple class just to store temporarily reordered soltab data.'''
    def __init__(self, values, axes, weights=None):
        """ Initialize a new SoltabCache instance.

        Args:
            values (ndarray): values to cache.
            axes (ndarray): axes to store.
            weights (ndarray or None): weights to cache.
        Returns:
            None
        """
        self.values = values
        self.axes = axes
        self.weights = weights

    def update(self, nvalues, naxes, weights=None):
        """ Update the data in the cache.

        Args:
            nvalues (ndarray): new values to store in the cache.
            naxes (ndarray): new axes to store in the cache.
            weights (ndarray or None): new weghts to store in the cache.
        Returns:
            None
        """
        self.values = nvalues
        self.axes = naxes
        self.weights = weights


# Global helper functions.
def reorder_soltab(st):
    """ Reorder a soltab in the order H5plot expects.

    The expected order in the plotter is time, frequency, antenna, polarization, direction.

    Args:
        st (SolTab): soltab instance to reorder the axes of.
    Returns:
        st_new (tuple): tuple of (values, weights, axes) reodered to the expected order.
        order_new (ndarray): array containing the reordered order of the axes.
    """
    LOGGER.info('Reordering soltab ' + st.name)
    order_old = st.getAxesNames()
    if ('phase_offset' in st.name):
        LOGGER.info('Not reordering phase_offset as it is a single number.')
    if ('rotationmeasure' in st.name) or ('RMextract'in st.name) or ('clock' in st.name) or ('faraday' in st.name) or ('tec' in st.name and 'freq' not in order_old):
        order_new = ['time', 'ant']
    else:
        order_new = ['time', 'freq', 'ant']
    if 'pol' in order_old:
        order_new += ['pol']
    if 'dir' in order_old:
        order_new += ['dir']
    t1 = time.time()
    # Read values and weights only once each; they can be very large.
    values, axis_values = st.getValues()
    weights = st.getValues(weight=True, retAxesVals=False)
    reordered = reorderAxes(values, order_old, order_new)
    reordered_weights = reorderAxes(weights, order_old, order_new)
    t2 = time.time()
    LOGGER.info('Reading and reordering took {:f} seconds'.format(t2 - t1))
    st_new = (reordered, {axis: axis_values[axis] for axis in order_new})
    return st_new, reordered_weights, order_new


def wrap_phase(phase):
    """ Map phases to the range -pi, pi.

    The formula (phase + np.pi) % (2 * np.pi) - np.pi is used to map phases into a plottable range.

    Args:
        phase (ndarray): narray of phases to remap.
    Returns:
        wphase (ndarray): narray of remapped phases.
    """
    wphase = (phase + np.pi) % (2 * np.pi) - np.pi
    return wphase


def add_log_file_handler(logger):
    """ Attach the shared h5plot.log file handler to a logger.

    The handler is created once, so opening plot windows does not open new log files.

    Args:
        logger (Logger): logger to attach the handler to.
    Returns:
        handler (FileHandler): the shared file handler.
    """
    global _LOG_FILE_HANDLER
    if _LOG_FILE_HANDLER is None:
        _LOG_FILE_HANDLER = logging.FileHandler('h5plot.log')
        _LOG_FILE_HANDLER.setLevel(logging.DEBUG)
        _LOG_FILE_HANDLER.setFormatter(logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s'))
    # addHandler ignores a handler that is already attached.
    logger.addHandler(_LOG_FILE_HANDLER)
    return _LOG_FILE_HANDLER


def pad_axis_gaps(axis, max_growth=20):
    """ Fill gaps in an irregular axis with samples at the smallest spacing.

    Args:
        axis (ndarray): monotonically increasing axis values.
        max_growth (int): do not pad if the padded axis would be this many times longer.
    Returns:
        padded (ndarray): axis with gaps filled.
        positions (ndarray): index of each original sample in the padded axis.
    """
    axis = np.asarray(axis, dtype=float)
    positions = np.arange(len(axis))
    if len(axis) < 3:
        return axis, positions
    steps = np.diff(axis)
    if not np.any(steps > 0) or np.allclose(steps, steps[0], rtol=0.01):
        return axis, positions
    step = np.min(steps[steps > 0])
    n_missing = np.maximum(np.rint(steps / step).astype(int) - 1, 0)
    padded_positions = positions + np.concatenate(([0], np.cumsum(n_missing)))
    if padded_positions[-1] + 1 > max_growth * len(axis):
        LOGGER.warning('Not padding axis gaps, the padded axis would be too large.')
        return axis, positions
    padded = np.interp(np.arange(padded_positions[-1] + 1), padded_positions, axis)
    return padded, padded_positions


def image_cells_to_indices(low, high, display_axis, positions):
    """ Convert a coordinate range on an imshow image to a range of solution indices.

    imshow spreads the image cells evenly between the first and last value of the displayed axis,
    so the cell edges are searched rather than the solution centers.

    Args:
        low (float): lower coordinate of the selection.
        high (float): upper coordinate of the selection.
        display_axis (ndarray): the (possibly padded) axis the image was drawn with.
        positions (ndarray): index of each solution in the displayed axis.
    Returns:
        start (int): first selected solution index.
        stop (int): one past the last selected solution index; equal to start if nothing was selected.
    """
    edges = np.linspace(display_axis[0], display_axis[-1], len(display_axis) + 1)
    cell_start = int(np.searchsorted(edges, low, side='right') - 1)
    cell_stop = int(np.searchsorted(edges, high, side='left'))
    selected = np.flatnonzero((positions >= cell_start) & (positions < cell_stop))
    if len(selected) == 0:
        return 0, 0
    return int(selected[0]), int(selected[-1]) + 1


def indices_to_selection(indices):
    """ Turn a list of indices into a slice if they are contiguous, so they can be written in one go.

    Args:
        indices (list): indices along an axis.
    Returns:
        selection (slice or list): a slice for contiguous indices, otherwise a sorted list.
    """
    indices = sorted(set(int(i) for i in indices))
    if indices == list(range(indices[0], indices[-1] + 1)):
        return slice(indices[0], indices[-1] + 1)
    return indices


def iterate_selections(axes, axis_indices):
    """ Yield selections over the given axes.

    PyTables only allows a single index list per selection, so the combinations of all lists are looped over.

    Args:
        axes (list): axis names in the order of the array to select from.
        axis_indices (dict): slice or list of indices per axis name. Missing axes are fully selected.
    Yields:
        selection (list): one index, slice or int per axis.
    """
    selection = [axis_indices.get(axis, slice(None)) for axis in axes]
    list_positions = [i for i, s in enumerate(selection) if isinstance(s, list)]
    for combination in itertools.product(*[selection[i] for i in list_positions]):
        current_selection = list(selection)
        for i, index in zip(list_positions, combination):
            current_selection[i] = index
        yield current_selection


@contextlib.contextmanager
def busy(status_label=None, message=''):
    """ Show a wait cursor, and optionally a message, while slow work runs, so the GUI does not look frozen.

    Pending redraws are run before the cursor is restored, so the feedback lasts until the plot is updated.

    Args:
        status_label (QLabel or None): label to show the message in.
        message (str): message to show while busy.
    """
    previous_message = status_label.text() if status_label is not None else ''
    QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
    if status_label is not None:
        status_label.setText(message)
    QApplication.processEvents(QtCore.QEventLoop.ExcludeUserInputEvents)
    try:
        yield
        QApplication.processEvents(QtCore.QEventLoop.ExcludeUserInputEvents)
    finally:
        if status_label is not None:
            status_label.setText(previous_message)
        QApplication.restoreOverrideCursor()


def exec_dialog(dialog):
    """ Run a modal Qt dialog; PyQt5 names the method exec_, PySide6 exec. """
    return dialog.exec() if hasattr(dialog, 'exec') else dialog.exec_()


def solution_range(axis_values, start, stop):
    """ Return the range covered by solutions start up to stop, including half a solution interval on both sides.

    Args:
        axis_values (ndarray or None): solution times or frequencies (centres of the solution intervals).
        start (int): first solution index.
        stop (int): one past the last solution index.
    Returns:
        range (tuple or None): (low, high), or None if the axis is missing or has a single solution,
        in which case the solution interval is unknown.
    """
    if axis_values is None or len(axis_values) < 2:
        return None
    axis_values = np.asarray(axis_values, dtype=float)
    steps = np.diff(axis_values)
    step = np.min(steps[steps > 0])
    return axis_values[start] - step / 2, axis_values[stop - 1] + step / 2


def mjd_seconds_to_mvtime(seconds):
    """ Format a time in MJD seconds (as used in H5parms and Measurement Sets) as a casacore MVTime string. """
    moment = datetime.datetime(1858, 11, 17) + datetime.timedelta(seconds=seconds)
    return moment.strftime('%Y/%m/%d/%H:%M:%S.') + '{:03d}'.format(moment.microsecond // 1000)


def _dp3_time_range(time_range):
    # Round outwards to a millisecond, so the boundary integrations are included.
    low = math.floor(time_range[0] * 1000) / 1000
    high = math.ceil(time_range[1] * 1000) / 1000
    return '{}..{}'.format(mjd_seconds_to_mvtime(low), mjd_seconds_to_mvtime(high))


def _dp3_freq_range(freq_range):
    # Round outwards to a Hz, so the boundary channels are included.
    return '{:.6f}..{:.6f} MHz'.format(math.floor(freq_range[0]) / 1e6, math.ceil(freq_range[1]) / 1e6)


def make_dp3_parset(flag_records, parset_name, source_h5file, flagged_h5file):
    """ Make a DP3 parset that applies the flags made in H5plot to the visibilities of a Measurement Set.

    Visibilities have no directions, and the DP3 preflagger flags all correlations, so flags in different
    directions or polarizations of the same stations, times and frequencies become a single keyword set.

    Args:
        flag_records (list): dicts describing the flag actions, as made by H5PlotGUI.update_waterfall_weights.
        parset_name (str): file name of the parset, used in the usage example.
        source_h5file (str): H5parm the flags were made in.
        flagged_h5file (str): H5parm the flags were written to.
    Returns:
        parset (str): the parset text.
    """
    keyword_sets = {}
    for record in flag_records:
        key = (tuple(record['stations']) if record['stations'] is not None else None, record['time'], record['freq'])
        keyword_sets.setdefault(key, []).append(record)
    lines = [
        '# DP3 flagging parset written by H5plot {} on {}.'.format(__version__, datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')),
        '# Flags made in {}'.format(source_h5file),
        '# and written to {}.'.format(flagged_h5file),
        '#',
        '# Apply the flags to a Measurement Set with:',
        '#     DP3 {} msin=<your.ms>'.format(parset_name),
        '# This writes the flags into the FLAG column of that Measurement Set (msout=.).',
        '#',
        '# Visibilities have no directions, so a flag in any direction flags the visibilities of that station, time',
        '# and frequency range. The DP3 preflagger flags all correlations, whichever polarizations were flagged in the',
        '# solutions. Time and frequency ranges cover the full solution intervals. A station flag applies to all',
        '# baselines with that station.',
        '',
        'msout = .',
        'steps = [preflag]',
        'preflag.type = preflagger',
    ]
    set_lines = []
    names = []
    for number, ((stations, time_range, freq_range), records) in enumerate(keyword_sets.items(), start=1):
        name = 'f{}'.format(number)
        names.append(name)
        set_lines.append('')
        for record in records:
            region = record['region']
            description = '{}/{}: {}, solution times {}:{}, solution frequencies {}:{}'.format(
                record['solset'], record['soltab'],
                'all stations' if record['stations'] is None else ', '.join(record['stations']),
                region[0], region[1], region[2], region[3])
            if record['pols'] is not None:
                description += ', polarizations ' + ', '.join(record['pols'])
            if record['dirs'] is not None:
                description += ', directions ' + ', '.join(record['dirs'])
            set_lines.append('# ' + description)
        if time_range is None:
            set_lines.append('# The solutions have a single time, so all times are flagged.')
        if freq_range is None:
            set_lines.append('# The solutions have no frequency axis or a single frequency, so all channels are flagged.')
        if stations is not None:
            set_lines.append('preflag.{}.baseline = [{}]'.format(name, ', '.join(stations)))
        if time_range is not None:
            set_lines.append('preflag.{}.abstime = [{}]'.format(name, _dp3_time_range(time_range)))
        if freq_range is not None:
            set_lines.append('preflag.{}.freqrange = [{}]'.format(name, _dp3_freq_range(freq_range)))
        if stations is None and time_range is None and freq_range is None:
            # A keyword set needs at least one selection; all stations matches all data.
            set_lines.append('preflag.{}.baseline = [*]'.format(name))
    lines.append('preflag.expr = ' + ' or '.join(names))
    return '\n'.join(lines + set_lines) + '\n'



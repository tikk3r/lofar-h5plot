    def _forward_button_event(self):
        """ An event triggered by pressing the "Forward" button of a GraphWindow.

        When pressed, the abscissa is advanced one position, showing the next time or frequency slot.
        """
        if (self.polslot < (len(self.polarizations) - 1)):
            self.polslot += 1
        if (self.polslot > 0) and (not self.button_prev.isEnabled()):
            self.button_prev.setEnabled(True)
        if self.polslot == (len(self.polarizations) - 1):
            self.button_next.setEnabled(False)
        self.select_label.setText('Corr.: {:s}'.format(self.polarizations[self.polslot]))
        diridx = self.parent.directions.index(self.direction)
        if self.gridplot:
            if self.nxm_dimensions is None:
                self.plot_all()
            else:
                self.plot_nxm(*self.nxm_dimensions)
        else:
            x, y, z, zw, p = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, self.polslot, direction=diridx)
            if self.mode == 'values':
                self.plot(x, y, np.where(zw, z, np.nan), self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'), isphase=p)
            elif self.mode == 'weights':
                self.plot(x, y, zw, self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'))

    def _backward_button_event(self):
        """ An event triggered by pressing the "Back" button of a GraphWindow.

        When pressed, the abscissa is set back one position, showing the previous time or frequency slot.
        """
        if (self.polslot > 0):
            self.polslot -= 1
        if self.polslot == 0:
            self.button_prev.setEnabled(False)
        if (self.polslot < (len(self.polarizations) - 1)) and (not self.button_next.isEnabled()):
            self.button_next.setEnabled(True)
        self.select_label.setText('Corr.: {:s}'.format(self.polarizations[self.polslot]))
        diridx = self.parent.directions.index(self.direction)
        if self.gridplot:
            if self.nxm_dimensions is None:
                self.plot_all()
            else:
                self.plot_nxm(*self.nxm_dimensions)
        else:
            x, y, z, zw, p = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, self.polslot, direction=diridx)
            if self.mode == 'values':
                self.plot(x, y, np.where(zw, z, np.nan), self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'), isphase=p)
            elif self.mode == 'weights':
                self.plot(x, y, zw, self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'))

    def plot_all(self):
        self.nxm_dimensions = None
        Nplots = len(self.parent.stations)
        Ncols = int(np.ceil(np.sqrt(Nplots)))
        Nrows = int(np.ceil(float(Nplots)/Ncols))
        station_indices = list(range(Nplots))
        self._plot_grid(station_indices, Ncols, Nrows)

    def plot_nxm(self, ncols, nrows):
        """Plot stations starting at the selected station in a fixed grid."""
        self.nxm_dimensions = (ncols, nrows)
        remaining_stations = len(self.parent.stations) - self.antindex
        Nplots = min(remaining_stations, ncols * nrows)
        station_indices = list(range(self.antindex, self.antindex + Nplots))
        self._plot_grid(station_indices, ncols, nrows)

    def _grid_weights(self, station_index):
        axes = self.parent.stcache.axes
        weights = self.parent.stcache.weights
        direction_index = self.parent.directions.index(self.direction)
        if ('pol' in axes) and ('dir' in axes):
            if self.do_poldiff:
                if self.poldifmode == PoldifMode.PARALLEL:
                    return weights[:, :, station_index, 0, direction_index] * weights[:, :, station_index, -1, direction_index]
                return weights[:, :, station_index, 1, direction_index] * weights[:, :, station_index, 2, direction_index]
            return weights[:, :, station_index, self.polslot, direction_index]
        if ('pol' not in axes) and ('dir' in axes):
            return weights[:, :, station_index, direction_index]
        if ('pol' in axes) and ('dir' not in axes):
            return weights[:, :, station_index, self.polslot]
        return weights[:, :, station_index]

    def _plot_grid(self, station_indices, Ncols, Nrows):
        if self.rectangle_selector is not None:
            self.rectangle_selector.disconnect_events()
            self.rectangle_selector = None
        for selector in self.grid_rectangle_selectors.values():
            selector.disconnect_events()
        self.grid_rectangle_selectors = {}
        self.selected_regions = []
        self.selected_region = None
        self.grid_pending_regions = {}
        self.selection_patches = []
        flagging_enabled = self.nxm_dimensions is not None
        self.mark_region_button.setEnabled(flagging_enabled)
        self.flag_button.setEnabled(False)
        self.flag_all_button.setEnabled(False)
        self.propagate_polarizations.setEnabled(flagging_enabled and not self.do_poldiff)
        self.propagate_directions.setEnabled(flagging_enabled)
        self.propagate_antennas.setEnabled(flagging_enabled)
        self.fig.clf()
        self.gridplot = True
        from matplotlib.gridspec import GridSpec
        import matplotlib.patheffects as pe
        # plot_window, axes = plt.subplots(Ncols, Nrows, figsize=(16, 9), constrained_layout=True)
        grid_bottom = 0.10
        grid_top = 0.95
        gs = GridSpec(Nrows, Ncols, figure=self.fig, left=0.05, right=0.95, bottom=grid_bottom, top=grid_top, hspace=0.04, wspace=0.025)
        global_limits = None
        if self.mode == 'values':
            global_limits = self.parent.get_global_limits()
        Nplots = len(station_indices)
        Nlim = Nplots
        self.grid_time_axis = np.asarray(self.parent.stcache.values[1]['time'])
        self.grid_time_axis = self.grid_time_axis - self.grid_time_axis[0]
        self.grid_freq_axis = np.asarray(self.parent.stcache.values[1]['freq']) / 1e6
        self.fig.suptitle(self.st.name + ' - {:s}'.format(self.direction))
        direction_index = self.parent.directions.index(self.direction)
        Nplotted = 0
        for i in range(Nrows):
            for j in range(Ncols):
                if Nplotted >= Nlim:
                    continue
                station_index = station_indices[Nplotted]
                ax = self.fig.add_subplot(gs[i, j])
                ax.set_title(self.parent.stations[station_index], y=1.0, pad=-15, color='white', fontweight='bold', path_effects=[pe.withStroke(linewidth=1, foreground="black")])
                x = self.parent.stcache.values[1]['time']
                y = self.parent.stcache.values[1]['freq'] / 1e6
                grid_weights = self._grid_weights(station_index)
                if self.mode == 'values':
                    if self.st.getType() == 'phase':
                        current_cmap = matplotlib.colormaps['hsv']
                        current_cmap.set_bad(color='w')
                        if ('pol' in self.parent.stcache.axes) and ('dir' in self.parent.stcache.axes):
                            if self.do_poldiff:
                                if self.poldifmode == PoldifMode.PARALLEL:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 0, direction_index] - self.parent.stcache.values[0][:, :, station_index, -1, direction_index]).T
                                elif self.poldifmode == PoldifMode.CROSS:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 1, direction_index] - self.parent.stcache.values[0][:, :, station_index, 2, direction_index]).T
                            else:
                                vals = (self.parent.stcache.values[0][:, :, station_index, self.polslot, direction_index] - self.parent.stcache.values[0][:, :, self.refantindex, self.polslot, direction_index]).T
                        elif not ('pol' in self.parent.stcache.axes) and ('dir' in self.parent.stcache.axes):
                            vals = (self.parent.stcache.values[0][:, :, station_index, direction_index] - self.parent.stcache.values[0][:, :, self.refantindex, direction_index]).T
                        elif ('pol' in self.parent.stcache.axes) and not ('dir' in self.parent.stcache.axes):
                            if self.do_poldiff:
                                if self.poldifmode == PoldifMode.PARALLEL:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 0] - self.parent.stcache.values[0][:, :, station_index, -1]).T
                                elif self.poldifmode == PoldifMode.CROSS:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 1] - self.parent.stcache.values[0][:, :, station_index, 2]).T
                            else:
                                vals = (self.parent.stcache.values[0][:, :, station_index, self.polslot] - self.parent.stcache.values[0][:, :, self.refantindex, self.polslot]).T
                        elif not ('pol' in self.parent.stcache.axes) and not ('dir' in self.parent.stcache.axes):
                            vals = (self.parent.stcache.values[0][:, :, station_index] - self.parent.stcache.values[0][:, :, self.refantindex]).T
                        if self.do_timediff:
                            vals = np.diff(vals, axis=1)
                        if self.do_freqdiff:
                            vals = np.diff(vals, axis=0)
                        vals = wrap_phase(vals)
                        im = ax.imshow(vals, aspect='auto', extent=[0, x[-1]-x[0], y[0], y[-1]], interpolation='none', cmap=current_cmap, origin='lower')
                        if global_limits is not None:
                            im.set_clim(global_limits[0], global_limits[1])
                        else:
                            im.set_clim(-np.pi, np.pi)
                    else:
                        current_cmap = matplotlib.colormaps['viridis']
                        current_cmap.set_bad(color='w')
                        if ('pol' in self.parent.stcache.axes) and ('dir' in self.parent.stcache.axes):
                            if self.do_poldiff:
                                if self.poldifmode == PoldifMode.PARALLEL:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 0, direction_index] - self.parent.stcache.values[0][:, :, station_index, -1, direction_index]).T
                                elif self.poldifmode == PoldifMode.CROSS:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 1, direction_index] - self.parent.stcache.values[0][:, :, station_index, 2, direction_index]).T
                            else:
                                vals = self.parent.stcache.values[0][:, :, station_index, self.polslot, direction_index].T
                        elif not ('pol' in self.parent.stcache.axes) and ('dir' in self.parent.stcache.axes):
                            vals = self.parent.stcache.values[0][:, :, station_index, direction_index].T
                        elif ('pol' in self.parent.stcache.axes) and not ('dir' in self.parent.stcache.axes):
                            if self.do_poldiff:
                                if self.poldifmode == PoldifMode.PARALLEL:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 0] - self.parent.stcache.values[0][:, :, station_index, -1]).T
                                elif self.poldifmode == PoldifMode.CROSS:
                                    vals = (self.parent.stcache.values[0][:, :, station_index, 1] - self.parent.stcache.values[0][:, :, station_index, 2]).T
                            else:
                                vals = self.parent.stcache.values[0][:, :, station_index, self.polslot].T
                        elif not ('pol' in self.parent.stcache.axes) and not ('dir' in self.parent.stcache.axes):
                            vals = self.parent.stcache.values[0][:, :, station_index].T
                        if self.do_timediff:
                            vals = np.diff(vals, axis=1)
                        if self.do_freqdiff:
                            vals = np.diff(vals, axis=0)
                        if global_limits is not None:
                            im = ax.imshow(vals, aspect='auto', extent=[0, x[-1]-x[0], y[0], y[-1]], interpolation='none', cmap=current_cmap, origin='lower', vmin=global_limits[0], vmax=global_limits[1])
                        else:
                            im = ax.imshow(vals, aspect='auto', extent=[0, x[-1]-x[0], y[0], y[-1]], interpolation='none', cmap=current_cmap, origin='lower', vmin=0.5, vmax=2.0)
                if self.mode == 'values':
                    vals = np.where(grid_weights.T != 0, vals, np.nan)
                    im.set_data(vals)
                elif self.mode == 'weights':
                    current_cmap = matplotlib.colormaps['viridis']
                    if ('pol' in self.parent.stcache.axes) and ('dir' in self.parent.stcache.axes):
                        vals = self.parent.stcache.weights[:, :, station_index, self.polslot, direction_index].T
                    elif not ('pol' in self.parent.stcache.axes) and ('dir' in self.parent.stcache.axes):
                        vals = self.parent.stcache.weights[:, :, station_index, direction_index].T
                    elif not ('pol' in self.parent.stcache.axes) and not ('dir' in self.parent.stcache.axes):
                        vals = self.parent.stcache.weights[:, :, station_index, self.polslot].T
                    im = ax.imshow(vals, aspect='auto', extent=[0, x[-1]-x[0], y[0], y[-1]], interpolation='none', cmap=current_cmap, origin='lower', vmin=0.0, vmax=1.0)
                if flagging_enabled:
                    x_span = x[-1] - x[0]
                    y_span = y[-1] - y[0]
                    x_padding = 0.02 * x_span if x_span else 0.02
                    y_padding = 0.0325 * y_span if y_span else 0.0325
                    ax.set_xlim(-x_padding, x[-1] - x[0] + x_padding)
                    ax.set_ylim(y[0] - y_padding, y[-1] + y_padding)
                self.grid_rectangle_selectors[station_index] = RectangleSelector(
                    ax,
                    lambda start_event, end_event, station_index=station_index: self._on_grid_region_selected(start_event, end_event, station_index),
                    useblit=False,
                    button=[1],
                    spancoords='data',
                    interactive=True)
                self.grid_rectangle_selectors[station_index].set_active(flagging_enabled and self.mark_region_button.isChecked())
                try:
                    self.fig.supxlabel('Time [s]', y=0.02)
                    self.fig.supylabel('Frequency [MHz]', x=0.01)
                except AttributeError:
                    self.LOGGER.warning('Setting labels with supxlabel/supylabel failed, not plotting axes labels. You may need to updated matplotlib to >3.4.')
                if (Nplotted % Ncols):
                    ax.yaxis.set_visible(False)
                if (Nplotted < Nplots - Ncols):
                    ax.xaxis.set_visible(False)
                Nplotted += 1
        cbar_ax = self.fig.add_axes([0.955, grid_bottom, 0.015, grid_top - grid_bottom])
        self.fig.colorbar(im, cax=cbar_ax)
        self.setWindowState(QtCore.Qt.WindowMaximized)
        self.btn_antiter_prev.setEnabled(self.nxm_dimensions is not None and self.antindex > 0)
        self.btn_antiter_next.setEnabled(
            self.nxm_dimensions is not None
            and self.antindex + Ncols * Nrows < len(self.parent.stations))
        self.canvas.draw()


    def plot(self, xaxis, yaxis, zaxis, frametitle='', limits=[None, None], ax_labels=['', ''], multidim=False, isphase=False):
        for selector in self.grid_rectangle_selectors.values():
            selector.disconnect_events()
        self.grid_rectangle_selectors = {}
        self.gridplot = False
        self.mark_region_button.setEnabled(True)
        self.flag_all_button.setEnabled(True)
        self.propagate_polarizations.setEnabled(not self.do_poldiff)
        self.propagate_directions.setEnabled(True)
        self.propagate_antennas.setEnabled(True)
        self.xlabel = ax_labels[0]
        self.ylabel = ax_labels[1]
        self.fig.clf()
        self.ax = self.fig.add_subplot(111)
        self.ax.clear()
        self.selected_regions = []
        self.selection_patches = []
        self.grid_pending_regions = {}
        if self.rectangle_selector is not None:
            self.rectangle_selector.disconnect_events()
        self.rectangle_selector = RectangleSelector(self.ax, self._on_region_selected, useblit=False, button=[1], spancoords='data', interactive=True)
        self.rectangle_selector.set_active(self.mark_region_button.isChecked())
        self.selected_region = None
        self.flag_button.setEnabled(False)
        # Store the exact displayed axes so rectangle coordinates map directly to data indices.
        self.plot_time_axis = np.asarray(xaxis) - xaxis[0]
        self.plot_freq_axis = np.asarray(yaxis) * 1e-6
        xaxis = self.plot_time_axis
        yaxis = self.plot_freq_axis
        if self.polarizations is not None:
            if self.do_poldiff:
                if self.poldifmode == PoldifMode.PARALLEL:
                    pol = '{:s} - {:s}'.format(self.polarizations[0], self.polarizations[-1])
                elif self.poldifmode == PoldifMode.CROSS:
                    pol = '{:s} - {:s}'.format(self.polarizations[1], self.polarizations[2])
            else:
                pol = self.polarizations[self.polslot]
            self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s}'.format(pol, self.direction))
            if self.do_timediff and not self.do_freqdiff:
                self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s} time diff'.format(pol, self.direction))
            if not self.do_timediff and self.do_freqdiff:
                self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s} frequency diff'.format(pol, self.direction))
            if self.do_timediff and self.do_freqdiff:
                self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s} - {:s} time and frequency diff'.format(pol, self.direction))
        else:
            self.ax.set_title(frametitle + ':' + self.st.name + ' - {:s}'.format(self.direction))
        tdiff = np.diff(xaxis)
        fdiff = np.diff(yaxis)
        solint_time = tdiff[0]
        solint_freq = fdiff[0]
        vals = zaxis.copy()
        plot_x = xaxis.copy()
        plot_y = yaxis.copy()
        if not np.allclose(np.diff(yaxis), np.diff(yaxis)[0], rtol=0.01): # if not evenly spaced
            self.LOGGER.warning('Found irregular frequency axis, padding gaps with NaNs...')
            gapidx = np.nanargmax(np.abs(np.diff(plot_y)) > 2*solint_freq)  # index BEFORE the gap
            gapsize = plot_y[gapidx+1] - plot_y[gapidx]
            y_spacing = solint_freq
            while (gapsize >= 2*y_spacing) and (len(plot_y) <= yaxis[-1] / solint_freq):
                vals = np.insert(vals, gapidx + 1, np.nan * np.ones((int(gapsize / y_spacing), vals.shape[0])), axis=1)  # fill gap with NaNs
                plot_y = np.insert(plot_y, gapidx + 1, np.arange(plot_y[gapidx], plot_y[gapidx + 1], solint_freq))  # fill gap with NaNs
                gapidx = np.nanargmax(np.abs(np.diff(plot_y)) >= 2*solint_freq)  # index BEFORE the gap
                gapsize = np.abs(plot_y[gapidx+1] - plot_y[gapidx])

        if not np.allclose(np.diff(xaxis), np.diff(xaxis)[0], rtol=0.01): # if not evenly spaced
            self.LOGGER.warning('Found irregular time axis, padding gaps with NaNs...')
            gapidx = np.nanargmax(np.abs(np.diff(plot_x)) > 2*solint_time)  # index BEFORE the gap
            gapsize = plot_x[gapidx+1] - plot_x[gapidx]
            x_spacing = solint_time
            while (gapsize >= 2*x_spacing) and (len(plot_x) <= xaxis[-1] / solint_time): # if gap greater 2 times y-spacing, pad NaNs
                vals = np.insert(vals, gapidx + 1, np.nan * np.ones((int(gapsize / x_spacing), vals.shape[1])), axis=0)  # fill gap with NaNs
                plot_x = np.insert(plot_x, gapidx + 1, np.arange(plot_x[gapidx], plot_x[gapidx + 1], solint_time))  # fill gap with NaNs
                gapidx = np.nanargmax(np.abs(np.diff(plot_x)) >= 2*solint_time)  # index BEFORE the gap
                gapsize = np.abs(plot_x[gapidx+1] - plot_x[gapidx])
        if self.parent.check_tdiff.isChecked():
            vals = np.diff(vals, axis=0)
            if self.st.getType() == 'phase':
                vals = wrap_phase(vals)
        if self.parent.check_fdiff.isChecked():
            vals = np.diff(vals, axis=1)
            if self.st.getType() == 'phase':
                vals = wrap_phase(vals)
        if isphase:
            vals = wrap_phase(vals)
            current_cmap = matplotlib.colormaps['hsv']
            current_cmap.set_bad(color='w')
            im = self.ax.imshow(vals.T, interpolation='none', extent=[plot_x[0], plot_x[-1], plot_y[0], plot_y[-1]], aspect='auto', cmap=current_cmap, origin='lower')
            global_limits = None
            if self.mode == 'values' and self.parent is not None:
                global_limits = self.parent.get_global_limits()
            if global_limits is not None:
                im.set_clim(global_limits[0], global_limits[1])
            else:
                im.set_clim(-np.pi, np.pi)
        else:
            current_cmap = matplotlib.colormaps['viridis']
            current_cmap.set_bad(color='w')
            im = self.ax.imshow(vals.T, interpolation='none', extent=[plot_x[0], plot_x[-1], plot_y[0], plot_y[-1]], aspect='auto', cmap=current_cmap, origin='lower')
            if self.mode == 'values' and self.parent is not None:
                global_limits = self.parent.get_global_limits()
                if global_limits is not None:
                    im.set_clim(global_limits[0], global_limits[1])
        cb = self.fig.colorbar(im)
        self.ax.set(xlabel=ax_labels[0], ylabel=ax_labels[1], xlim=limits[0], ylim=limits[1])
        if limits[0] is None:
            x_span = plot_x[-1] - plot_x[0]
            x_padding = 0.02 * x_span if x_span else 0.02
            self.ax.set_xlim(plot_x[0] - x_padding, plot_x[-1] + x_padding)
        if limits[1] is None:
            y_span = plot_y[-1] - plot_y[0]
            y_padding = 0.0325 * y_span if y_span else 0.0325
            self.ax.set_ylim(plot_y[0] - y_padding, plot_y[-1] + y_padding)
        self.canvas.draw()


class ListWidget(QListWidget):
    """ Version of QListWidget that resizes itself.
    
    https://stackoverflow.com/questions/63497841/qlistwidget-does-not-resize-itself
    """
    INITIAL_HEIGHT = 300

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)
        self.setSizeAdjustPolicy(QtWidgets.QAbstractScrollArea.AdjustToContents)


    def minimumSizeHint(self) -> QtCore.QSize:
        return QtCore.QSize(-1, -1)


    def viewportSizeHint(self) -> QtCore.QSize:
        if self.model().rowCount() == 0:
            return QtCore.QSize(self.width(), 0)
        height = sum(self.sizeHintForRow(i) for i in range(self.count()) if not self.item(i).isHidden())
        width = super().viewportSizeHint().width()
        return QtCore.QSize(width, min(height, self.INITIAL_HEIGHT))


class H5PlotGUI(QWidget):
    """The main GUI for H5Plot.

    From here the SolSets, SolTabs and antennas to plot are selected.
    """
    def __init__(self, h5file, logging_instance, parent=None):
        """ Initialize a new instances of the H5PlotGUI.

        Args:
            h5file (str): name of the H5Parm to open.
            logging_instance (logging): an instance of the logging module to log to.
        Returns:
            None
        """
        super(H5PlotGUI, self).__init__(parent)
        self.logger = logging_instance
        self.source_h5file = os.path.abspath(h5file)
        self.h5filename = os.path.basename(h5file)
        self.flagged_h5parm = None
        self.flagged_h5file = None
        self.figures = []

        self.h5parm = lh5.h5parm(self.source_h5file, readonly=True)
        self.solset_labels = self.h5parm.getSolsetNames()
        self.solset = self.h5parm.getSolset(self.solset_labels[0])

        self.soltab_labels = self.solset.getSoltabNames()
        self.soltab = self.solset.getSoltab(self.soltab_labels[0])
        self.soltab_axes = list(self.soltab.getAxesNames())

        for l in self.soltab_labels:
            try:
                self.frequencies = self.solset.getSoltab(l).getAxisValues('freq')
                break
            except TypeError:
                pass
        for l in self.soltab_labels:
            try:
                self.times = self.solset.getSoltab(l).getAxisValues('time')
                break
            except TypeError:
                pass
        for l in self.soltab_labels:
            try:
                if 'pol' in self.solset.getSoltab(l).getAxesNames():
                    self.polarizations = self.solset.getSoltab(l).getAxisValues('pol')
                break
            except TypeError:
                pass
        self.stations = self.soltab.getValues()[1]['ant']
        try:
            self.directions = [s.decode('utf-8') for s in self.solset.getSou().keys()]

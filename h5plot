    def _pdiff_event(self):
        if self.check_pdiff.isChecked():
            self.check_pdiffx.setChecked(False)
            self.poldifmode = PoldifMode.PARALLEL
            self.do_poldiff = True
            self.logger.debug("Switched to parallel hand poldif")
        elif not self.check_pdiff.isChecked():
            self.do_poldiff = False

    def _pdiffx_event(self):
        if self.check_pdiffx.isChecked():
            self.check_pdiff.setChecked(False)
            self.poldifmode = PoldifMode.CROSS
            self.do_poldiff = True
            self.logger.debug("Switched to cross hand poldif")
        elif not self.check_pdiffx.isChecked():
            self.do_poldiff = False

    def _first_unflagged_station(self):
        """Return ST001 when valid, otherwise the first station with valid data."""
        ant_axis = self.stcache.axes.index('ant')
        station_weights = np.moveaxis(self.stcache.weights, ant_axis, 0)
        has_valid_data = np.any(
            np.isfinite(station_weights) & (station_weights > 0),
            axis=tuple(range(1, station_weights.ndim)))

        station_names = [station.decode('utf-8') if isinstance(station, bytes) else station for station in self.stations]
        if 'ST001' in station_names:
            st001_index = station_names.index('ST001')
            if has_valid_data[st001_index]:
                return self.stations[st001_index]

        valid_indices = np.flatnonzero(has_valid_data)
        if len(valid_indices) > 0:
            return self.stations[valid_indices[0]]
        return self.stations[0]

    def _update_poldiff_controls(self):
        try:
            pol_count = len(self.soltab.getAxisValues('pol'))
        except TypeError:
            pol_count = 0

        parallel_enabled = pol_count == 2
        cross_enabled = pol_count == 4
        if not parallel_enabled and self.check_pdiff.isChecked():
            self.check_pdiff.setChecked(False)
        if not cross_enabled and self.check_pdiffx.isChecked():
            self.check_pdiffx.setChecked(False)
        self.check_pdiff.setVisible(parallel_enabled)
        self.check_pdiffx.setVisible(cross_enabled)


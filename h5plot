def load_axes(vals, st, axis_type, antenna, refantenna, timeslot=0, freqslot=0, direction=0, weights=None):
    """ Load an abscissa and ordinate from the H5Parm.

    Args:
        vals (ndarray): raw soltab values to load.
        st_type (str): string describing the type of solutions (e.g. phase, clock, amplitude).
        axis_type (str): `time` or `freq`.
        antenna (str): name of the antenna to select. Automatically determined if set to `None`.
        refant (int): index of the reference antenna.
        timeslot (int): timeslot to load.
        freqslot (int): frequency slot to load.
        direction (int): direction to load.
        weights (ndarray or None): weights for soltab values.
    Returns:
        xaxis (ndarray): an absicssa to plot.
        yaxis (ndarray): an ordinate to plot.
        yaxis_weight (ndarray): weights for the ordinate to plot.
        plabels (list): a list of labels for each plot (e.g. different polarizations).
        isphase (bool): boolean indicating whether or not the quantity is a phase.

        OR

        errorcode (str): an error message if things went wrong.
    """
    wrapphase = True
    # Values have shape (timestamps, frequencies, antennas, polarizations, directions).
    axes = st.getAxesNames()
    st_type = st.getType()
    x_axis = vals[1][axis_type]
    values = vals[0]
    plabels = []
    isphase = False
    if weights is None:
        weights = np.ones(values.shape)

    if axis_type == 'time':
        if ('rotationmeasure' in st.name) or ('faraday' in st.name) or ('tec' in st.name and 'freq' not in axes and 'dir' not in axes):
            y_axis = values[:, antenna] - values[:, refantenna]
            y_axis_weight = weights[:, antenna]
            Y_AXIS = y_axis
            Y_AXIS_WEIGHT = y_axis_weight
        elif ('pol' in axes) and ('dir' in axes):
            if st_type == 'phase':
                isphase = True
                # Plot phase-like quantities w.r.t. to a reference antenna.
                y_axis = values[:, freqslot, antenna, :, direction] - values[:, freqslot, refantenna, :, direction]
                y_axis_weight = weights[:, freqslot, antenna, :, direction]
                if wrapphase:
                    y_axis = wrap_phase(y_axis)
            elif (st_type == 'clock') or (st_type == 'rotationmeasure') or ((st_type == 'tec' or st_type == 'phase') and 'freq' not in axes):
                # No frequency axis: values have shape (time, ant, pol, dir).
                y_axis = values[:, antenna, :, direction] - values[:, refantenna, :, direction]
                y_axis_weight = weights[:, antenna, :, direction]
            else:
                y_axis = values[:, freqslot, antenna, :, direction]
                y_axis_weight = weights[:, freqslot, antenna, :, direction]
            Y_AXIS = []
            Y_AXIS_WEIGHT = []
            plabels = []
            # Iterate over polarizations.
            for i in range(y_axis.shape[1]):
                Y_AXIS.append(y_axis[:, i])
                Y_AXIS_WEIGHT.append(y_axis_weight[:, i])
                plabels.append(vals[1]['pol'][i])
        elif 'pol' in axes:
            if st_type == 'phase':
                isphase = True
                # Plot phase-like quantities w.r.t. to a reference antenna.
                y_axis = values[:, freqslot, antenna, :] - values[:, freqslot, refantenna, :]
                y_axis_weight = weights[:, freqslot, antenna, :]
                if wrapphase:
                    y_axis = wrap_phase(y_axis)
            elif (st_type == 'clock') or (st_type == 'rotationmeasure') or (st_type == 'tec') or (st_type == 'phase' and 'freq' not in axes):
                y_axis = values[:, antenna] - values[:, refantenna]
                y_axis_weight = weights[:, antenna]
            else:
                y_axis = values[:, freqslot, antenna, :]
                y_axis_weight = weights[:, freqslot, antenna, :]
            Y_AXIS = []
            Y_AXIS_WEIGHT = []
            plabels = []
            for i in range(y_axis.shape[1]):
                Y_AXIS.append(y_axis[:, i])
                Y_AXIS_WEIGHT.append(y_axis_weight[:, i])
                plabels.append(vals[1]['pol'][i])
        elif 'dir' in axes:
            if st_type == 'phase':
                isphase = True
                # Plot phase-like quantities w.r.t. to a reference antenna.
                y_axis = values[:, freqslot, antenna, direction] - values[:, freqslot, refantenna, direction]
                y_axis_weight = weights[:, freqslot, antenna, direction]
                if wrapphase:
                    y_axis = wrap_phase(y_axis)
            elif (st_type == 'clock') or (st_type == 'rotationmeasure') or ((st_type == 'tec' or st_type == 'phase') and 'freq' not in axes):
                y_axis = values[:, antenna, direction] - values[:, refantenna, direction]
                y_axis_weight = weights[:, antenna, direction]
            else:
                y_axis = values[:, freqslot, antenna, direction]
                y_axis_weight = weights[:, freqslot, antenna, direction]
            Y_AXIS = y_axis
            Y_AXIS_WEIGHT = y_axis_weight
        elif ('pol' not in axes) and ('dir' not in axes):
            if (st_type == 'clock') or (st_type == 'rotationmeasure') or ((st_type == 'tec' or st_type == 'phase') and 'freq' not in axes):
                y_axis = values[:, antenna] - values[:, refantenna]
                y_axis_weight = weights[:, antenna]
            elif ((st_type == 'tec' or st_type == 'phase') and 'freq' in axes):
                y_axis = values[:, 0, antenna] - values[:, 0, refantenna]
                y_axis_weight = weights[:, 0, antenna]
            else:
                # Assume normal time, freq, antenna ordering.
                y_axis = values[:, freqslot, antenna]
                y_axis_weight = weights[:, freqslot, antenna]
            Y_AXIS = y_axis
            Y_AXIS_WEIGHT = y_axis_weight
    elif axis_type == 'freq':
        if ('rotationmeasure' in st.name) or ('clock' in st.name) or ('faraday' in st.name) or ('tec' in st.name):
            logging.warning('Rotation Measure does not support frequency axis! Switch to time instead.')
        if ('pol' in axes) and ('dir' in axes):
            if st_type == 'phase':
                isphase = True
                # Plot phase-like quantities w.r.t. to a reference antenna.
                y_axis = values[timeslot, :, antenna, :, direction] - values[timeslot, :, refantenna, :, direction]
                y_axis_weight = weights[timeslot, :, antenna, :, direction]
                if wrapphase:
                    y_axis = wrap_phase(y_axis)
            else:
                y_axis = values[timeslot, :, antenna, :, direction]
                y_axis_weight = weights[timeslot, :, antenna, :, direction]
            Y_AXIS = []
            Y_AXIS_WEIGHT = []
            plabels = []
            for i in range(y_axis.shape[1]):
                Y_AXIS.append(y_axis[:, i])
                Y_AXIS_WEIGHT.append(y_axis_weight[:, i])
                plabels.append(vals[1]['pol'][i])
        elif 'pol' in axes:
            if st_type == 'phase':
                isphase = True
                # Plot phase-like quantities w.r.t. to a reference antenna.
                y_axis = values[timeslot, :, antenna, :] - values[timeslot, :, refantenna, :]
                y_axis_weight = weights[timeslot, :, antenna, :]
                if wrapphase:
                    y_axis = wrap_phase(y_axis)
            else:
                y_axis = values[timeslot, :, antenna, :]
                y_axis_weight = weights[timeslot, :, antenna, :]
            Y_AXIS = []
            Y_AXIS_WEIGHT = []
            plabels = []
            for i in range(y_axis.shape[1]):
                Y_AXIS.append(y_axis[:, i])
                Y_AXIS_WEIGHT.append(y_axis_weight[:, i])
                plabels.append(vals[1]['pol'][i])
        elif 'dir' in axes:
            if st_type == 'phase':
                isphase = True
                # Plot phase-like quantities w.r.t. to a reference antenna.
                y_axis = values[timeslot, :, antenna, direction] - values[timeslot, :, refantenna, direction]
                y_axis_weight = weights[timeslot, :, antenna, direction]
                if wrapphase:
                    y_axis = wrap_phase(y_axis)
            else:
                y_axis = values[timeslot, :, antenna, direction]
                y_axis_weight = weights[timeslot, :, antenna, direction]
            Y_AXIS = y_axis
            Y_AXIS_WEIGHT = y_axis_weight
        elif ('pol' not in axes) and ('dir' not in axes):
            y_axis = values[timeslot, :, antenna]
            y_axis_weight = weights[timeslot, :, antenna]
            Y_AXIS = y_axis
            Y_AXIS_WEIGHT = y_axis_weight
    if len(plabels) == 0:
        plabels = ['', '', '', '']
    return x_axis, Y_AXIS, Y_AXIS_WEIGHT, plabels, isphase


def load_axes_2d(vals, weights, st, antenna, refantenna, pol=0, direction=0):
    """ Load a 2D slice from the H5Parm.

    Args:
        vals (ndarray): raw soltab values to load as obtained from Soltab.getValues().
        weights (ndarray): weights corresponding to vals.
        st (soltab): soltab object.
        antenna (str): name of the antenna to select. Automatically determined if set to `None`.
        refant (int): index of the reference antenna.
        pol (int): polarization to load.
        direction (int): direction to load.
    Returns:
        x_axis (ndarray): time axis
        y_axis (ndarray): frequency axis
        plotvals (ndarray): 2d ndarray of soltab values
        isphase (bool): boolean indicating whether or not the quantity is a phase.

        OR

        errorcode (str): an error message if things went wrong.
    """
    wrapphase = True
    # Values have shape (timestamps, frequencies, antennas, polarizations, directions).
    axes = st.getAxesNames()
    st_type = st.getType()
    x_axis = vals[1]['time']
    y_axis = vals[1]['freq']
    values = np.asarray(vals[0])
    pols = list(vals[1]['pol']) if 'pol' in vals[1] else None
    if (st_type == 'phase') or (st_type == 'rotation'):
        isphase = True
    else:
        isphase = False
    if isphase:
        if 'polalign' in st.name:
            # Special case. We must plot XX-YY and XX is 0 so not informative anyway.
            # There's probably a nicer way of doing this.
            # This by definition has polarizations, no need to check.
            if 'dir' in axes:
                plotvals = (values[:, :, antenna, pols.index('XX'), direction] - values[:, :, antenna, pols.index('YY'), direction]) - (values[:, :, refantenna, pols.index('XX'), direction] - values[:, :, refantenna, pols.index('YY'), direction])
                plotvals_weight = weights[:, :, antenna, pol, direction]
            else:
                plotvals = (values[:, :, antenna, pols.index('XX')] - values[:, :, antenna, pols.index('YY')]) - (values[:, :, refantenna, pols.index('XX')] - values[:, :, refantenna, pols.index('YY')])
                plotvals_weight = weights[:, :, antenna, pol]
        else:
            if 'pol' in axes:
                if 'dir' in axes:
                    plotvals = values[:, :, antenna, pol, direction] - values[:, :, refantenna, pol, direction]
                    plotvals_weight = weights[:, :, antenna, pol, direction]
                else:
                    plotvals = values[:, :, antenna, pol] - values[:, :, refantenna, pol]
                    plotvals_weight = weights[:, :, antenna, pol]
            elif 'dir' in axes:
                plotvals = values[:, :, antenna, direction] - values[:, :, refantenna, direction]
                plotvals_weight = weights[:, :, antenna, direction]
            else:
                plotvals = values[:, :, antenna] - values[:, :, refantenna]
                plotvals_weight = weights[:, :, antenna]
        if wrapphase:
            plotvals = wrap_phase(plotvals)
    else:
        if 'pol' in axes:
            if 'dir' in axes:
                plotvals = values[:, :, antenna, pol, direction]
                plotvals_weight = weights[:, :, antenna, pol, direction]
            else:
                plotvals = values[:, :, antenna, pol]
                plotvals_weight = weights[:, :, antenna, pol]
        elif 'dir' in axes:
            plotvals = values[:, :, antenna, direction]
            plotvals_weight = weights[:, :, antenna, direction]
        else:
            plotvals = values[:, :, antenna]
            plotvals_weight = weights[:, :, antenna]
    return x_axis, y_axis, plotvals, plotvals_weight, isphase


class PlotWindowBase(QDialog):
    """ Functionality shared by the 1D and 2D plot windows. """
    def set_plot_window_title(self, plot_title):
        """Set the window title with the station and source HDF filename."""
        if self.h5filename:
            self.setWindowTitle('{} - {}'.format(plot_title, self.h5filename))
        else:
            self.setWindowTitle(plot_title)

    def format_time(self, seconds):
        """ Formats the time to be displayed in the plotting windows.

        A string is formatted, displaying the time in seconds or (fractional) minutes or hours.

        Args:
            seconds (int): the time in seconds.
        Returns:
            formatted time (str): formatted time string.
        """
        if seconds < 60:
            return '{:.3f} sec'.format(seconds)
        elif seconds < 3600:
            return '{:.3f} min'.format(seconds / 60)
        return '{:.3f} hr'.format(seconds / 3600)

    def _clear_selection(self):
        """ Forget all marked regions and remove their outlines from the plot. """
        self.selected_region = None
        self.selected_regions = []
        self.grid_pending_regions = {}
        for patch in self.selection_patches:
            patch.remove()
        self.selection_patches = []
        self.flag_button.setEnabled(False)


    @staticmethod
    def _press_is_inside(selector, event):
        """ Whether a mouse press falls inside the rectangle of a selector, i.e. adjusts it rather than starting a new one. """
        x_start, x_end, y_start, y_end = selector.extents
        return min(x_start, x_end) <= event.xdata <= max(x_start, x_end) and min(y_start, y_end) <= event.ydata <= max(y_start, y_end)

    def _keep_marked_region(self, selector):
        """ Outline the region of a selector in red and get the selector ready for the next region.

        Only the axes of the selector is redrawn, using blitting: a full redraw of large waterfalls takes long.
        """
        ax = selector.ax
        x_start, x_end, y_start, y_end = selector.extents
        patch = ax.add_patch(Rectangle((min(x_start, x_end), min(y_start, y_end)), abs(x_end - x_start), abs(y_end - y_start), fill=False, edgecolor='red'))
        self.selection_patches.append(patch)
        if hasattr(selector, 'clear'):
            selector.clear()
        else:
            selector.set_visible(False)
        background = get_selector_background(selector) if selector.useblit else None
        if background is None:
            self.canvas.draw_idle()
            return
        self.canvas.restore_region(background)
        ax.draw_artist(patch)
        self.canvas.blit(ax.bbox)
        # Store the outline in the background, so it stays visible while the next region is dragged.
        if not set_selector_background(selector, self.canvas.copy_from_bbox(ax.bbox)):
            self.canvas.draw_idle()

class GraphWindow(PlotWindowBase):
    """ A window displaying the plotted quantity. Allows the user to cycle through time or frequency.
    """
    def __init__(self, values, weights, frametitle, antindex, refantindex, axis, st, timeslot=0, freqslot=0, direction=0, times=None, freqs=None, parent=None, mode='values', do_timediff=False, do_freqdiff=False, do_poldiff=False, poldifmode=PoldifMode.NONE):
        """ Initialize a new GraphWindow instance.

        Args:
            frametitle (str): title the frame will hvae.
            antindex (int): the index of the selected antenna.
            axis (str): the type of axis being plotted (time or freq).
            timeslot (int): index along the time axis to start with.
            freqslot (int): index along the frequency axis to start with.
            direction (str): name of the direction to plot.
            parent (QDialog): parent window instance.
        Returns:
            None
        """
        super(GraphWindow, self).__init__()
        self.setWindowFlags(QtCore.Qt.WindowSystemMenuHint | QtCore.Qt.WindowMinMaxButtonsHint | QtCore.Qt.WindowCloseButtonHint)
        # Set up for logging output.
        self.LOGGER = logging.getLogger('GraphWindow')
        # LOGGER.setLevel(logging.INFO)
        self.LOGGER.setLevel(logging.DEBUG)

        self.frametitle = frametitle
        self.axis = axis
        self.timeslot = 0
        self.freqslot = 0
        self.direction = direction
        self.values = values
        self.weights = parent.stcache.weights if parent is not None else weights
        self.antindex = antindex
        self.refantindex = refantindex
        self.st = st
        self.st_name = getattr(st, 'name', None)
        self.solset_name = parent.solset.name if parent is not None and hasattr(parent, 'solset') else None
        self.parent = parent
        # Keep the soltab context this window was opened with, so switching soltab in the main window does not affect it.
        self.stations = parent.stations if parent is not None else None
        self.directions = list(parent.directions) if parent is not None else None
        self.cache_axes = list(parent.stcache.axes) if parent is not None else None
        self.h5filename = getattr(parent, 'h5filename', '')
        self.ax = None
        self.rectangle_selector = None
        self.selected_region = None
        self.selected_regions = []
        self.selection_patches = []
        self.mode = mode
        self.do_timediff = do_timediff
        self.do_freqdiff = do_freqdiff
        self.do_poldiff = do_poldiff
        self.poldifmode = poldifmode
        self.frequencies = freqs
        # Times are shown relative to the first solution.
        self.times = times - times[0] if times is not None else None

        add_log_file_handler(self.LOGGER)

        self.set_plot_window_title(frametitle)

        self.button_next = QPushButton('Forward')
        self.button_next.clicked.connect(self._forward_button_event)
        self.button_prev = QPushButton('Back')
        self.button_prev.clicked.connect(self._backward_button_event)
        self.button_prev.setEnabled(False)
        if 'time' in axis.lower():
            try:
                self.select_label = QLabel('Frequency: {:.3f} MHz'.format(self.frequencies[freqslot] / 1e6))
                if len(self.frequencies) == 1:
                    self.button_next.setEnabled(False)
                else:
                    self.button_next.setEnabled(True)
            except TypeError:
                # No frequency axis.
                self.select_label = QLabel('')
                self.button_next.setEnabled(False)
                self.button_prev.setEnabled(False)
        elif 'freq' in axis.lower():
            try:
                self.select_label = QLabel('Time: ' + self.format_time(self.times[timeslot]))
                if len(self.times) == 1:
                    self.button_next.setEnabled(False)
                else:
                    self.button_next.setEnabled(True)
            except TypeError:
                # No time axis.
                self.select_label = QLabel('')
                self.button_next.setEnabled(False)
                self.button_prev.setEnabled(False)
        self.select_label.setAlignment(QtCore.Qt.AlignCenter)

        self.btn_antiter_next = QPushButton('Next antenna')
        self.btn_antiter_next.clicked.connect(self._antiter_next_button_event)
        self.btn_antiter_prev = QPushButton('Previous antenna')
        self.btn_antiter_prev.clicked.connect(self._antiter_prev_button_event)

        self.btn_diriter_next = QPushButton('Next direction')
        self.btn_diriter_next.clicked.connect(self._diriter_next_button_event)
        self.btn_diriter_prev = QPushButton('Previous direction')
        self.btn_diriter_prev.clicked.connect(self._diriter_prev_button_event)
        has_multiple_directions = (
            self.parent is not None
            and 'dir' in self.st.getAxesNames()
            and len(self.directions) > 1)
        self.btn_diriter_next.setEnabled(has_multiple_directions)
        self.btn_diriter_prev.setEnabled(has_multiple_directions)

        antiter_widget = QWidget()
        antiter_layout = QHBoxLayout(antiter_widget)
        antiter_layout.addWidget(self.btn_antiter_prev)
        antiter_layout.addWidget(self.btn_antiter_next)
        antiter_layout.addWidget(self.btn_diriter_prev)
        antiter_layout.addWidget(self.btn_diriter_next)

        self.mark_region_button = QPushButton('Mark region')
        self.mark_region_button.setCheckable(True)
        self.mark_region_button.setShortcut('A')
        self.mark_region_button.toggled.connect(self._toggle_region_selection)
        self.flag_button = QPushButton('Flag')
        self.flag_button.clicked.connect(self._flag_selected_region)
        self.flag_button.setEnabled(False)
        self.flag_all_button = QPushButton('Flag all points')
        self.flag_all_button.clicked.connect(self._flag_all_points)
        self.propagate_flags_label = QLabel('Expand flags:')
        self.propagate_polarizations = QCheckBox('polarizations')
        self.propagate_polarizations.setChecked(True)
        self.propagate_polarizations.setEnabled(not self.do_poldiff)
        self.propagate_directions = QCheckBox('directions')
        self.propagate_directions.setChecked(True)
        self.propagate_antennas = QCheckBox('antennas')
        region_widget = QWidget()
        region_layout = QHBoxLayout(region_widget)
        region_layout.addWidget(self.mark_region_button)
        region_layout.addWidget(self.flag_button)
        region_layout.addWidget(self.flag_all_button)
        region_layout.addWidget(self.propagate_flags_label)
        region_layout.addWidget(self.propagate_polarizations)
        region_layout.addWidget(self.propagate_directions)
        region_layout.addWidget(self.propagate_antennas)

        self.buttons = QGridLayout()
        self.buttons.addWidget(self.button_prev, 0, 0)
        self.buttons.addWidget(self.select_label, 0, 1)
        self.buttons.addWidget(self.button_next, 0, 2)

        self.scrolls = QGridLayout()
        self.scrollbar = QScrollBar()
        self.scrollbar.setOrientation(QtCore.Qt.Horizontal)
        if 'time' in axis.lower() and self.frequencies is not None:
            self.scrollbar.setRange(0, len(self.frequencies)-1)
        elif 'freq' in axis.lower()  and self.times is not None:
            self.scrollbar.setRange(0, len(self.times)-1)
        else:
            self.scrollbar.setDisabled(True)
        self.scrollbar.valueChanged.connect(self._scrollbar_event)
        self.scrolls.addWidget(self.scrollbar, 0, 0)

        self.fig = Figure()
        self.canvas = FigureCanvas(self.fig)
        self.canvas.mpl_connect('button_press_event', self._on_region_press)
        self.toolbar = NavigationToolbar(self.canvas, self)

        self.layout = QVBoxLayout()
        self.layout.addWidget(self.toolbar)
        self.layout.addWidget(self.canvas, stretch=500)
        self.layout.addItem(self.buttons)
        self.layout.addItem(self.scrolls)
        self.layout.addWidget(antiter_widget)
        self.layout.addWidget(region_widget)
        self.status_label = QLabel('')
        self.layout.addWidget(self.status_label)
        self.setLayout(self.layout)

    def _toggle_region_selection(self, enabled):
        if self.rectangle_selector is not None:
            self.rectangle_selector.set_active(enabled)
        if not enabled:
            self._clear_selection()
            self.canvas.draw_idle()

    def _on_region_press(self, event):
        if event.inaxes is not self.ax or self.selected_region is None or self.rectangle_selector is None:
            return
        if event.xdata is None or event.ydata is None or self._press_is_inside(self.rectangle_selector, event):
            return
        self.selected_regions.append(self.selected_region)
        self.selected_region = None
        self._keep_marked_region(self.rectangle_selector)

    def _on_region_selected(self, start_event, end_event):
        if start_event.xdata is None or end_event.xdata is None:
            return
        x_low = min(start_event.xdata, end_event.xdata)
        x_high = max(start_event.xdata, end_event.xdata)
        axis_start = int(np.searchsorted(self.plot_axis, x_low, side='left'))
        axis_stop = int(np.searchsorted(self.plot_axis, x_high, side='right'))
        axis_start = max(0, min(axis_start, len(self.plot_axis) - 1))
        axis_stop = max(0, min(axis_stop, len(self.plot_axis)))
        if 'time' in self.axis.lower():
            self.selected_region = (axis_start, axis_stop, self.freqslot, self.freqslot + 1)
        else:
            self.selected_region = (self.timeslot, self.timeslot + 1, axis_start, axis_stop)
        self.flag_button.setEnabled(axis_start < axis_stop)

    def _flag_region(self, region):
        polarization = None if self.propagate_polarizations.isChecked() else 0
        self.parent.update_waterfall_weights(region, self.antindex, polarization, self.directions.index(self.direction), 0.0, self.propagate_directions.isChecked(), self.propagate_polarizations.isChecked(), self.propagate_antennas.isChecked(), dialog_parent=self)

    def _flag_regions(self, regions):
        if not regions:
            return
        x_limits = self.ax.get_xlim()
        y_limits = self.ax.get_ylim()
        with busy(self.status_label, 'Flagging, please wait...'):
            for region in regions:
                self._flag_region(region)
            self._clear_selection()
            self._refresh_current_plot(x_limits, y_limits)

    def _flag_selected_region(self):
        regions = list(self.selected_regions)
        if self.selected_region is not None:
            regions.append(self.selected_region)
        self._flag_regions(regions)

    def _flag_all_points(self):
        if 'time' in self.axis.lower():
            region = (0, len(self.plot_axis), self.freqslot, self.freqslot + 1)
        else:
            region = (self.timeslot, self.timeslot + 1, 0, len(self.plot_axis))
        self._flag_regions([region])

    def _refresh_current_plot(self, x_limits=None, y_limits=None):
        x, y, yw, labels, isphase = self._load_current()
        legend = self.ax.get_legend()
        legend_loc = legend._loc if legend is not None else None
        self.plot(x, y, yw, self.frametitle, ax_labels=[self.xlabel, self.ylabel], plot_labels=labels, isphase=isphase, legend_loc=legend_loc)
        if x_limits is not None:
            self.ax.set_xlim(x_limits)
        if y_limits is not None:
            self.ax.set_ylim(y_limits)
        self.canvas.draw_idle()

    def _default_x_limits(self, xaxis):
        xaxis = np.asarray(xaxis)
        if 'time' in self.xlabel.lower():
            xaxis = xaxis - xaxis[0]
        x_min = xaxis.min()
        x_max = xaxis.max()
        x_span = x_max - x_min
        x_padding = 0.02 * x_span if x_span else 0.02
        return [x_min - x_padding, x_max + x_padding]

    def _load_current(self):
        """ Load the axes for the current antenna, direction and time or frequency slot. """
        return load_axes(self.values, self.st, self.axis, self.antindex, self.refantindex, timeslot=self.timeslot, freqslot=self.freqslot, direction=self.directions.index(self.direction), weights=self.weights)

    def _step_antenna(self, step):
        self.antindex = (self.antindex + step) % len(self.stations)
        x, y, yw, l, p = self._load_current()
        self.frametitle = self.stations[self.antindex]
        self.plot(x, y, yw, self.frametitle, limits=[self._default_x_limits(x), None], ax_labels=[self.xlabel, self.ylabel], plot_labels=l, isphase=p)
        self.set_plot_window_title(self.frametitle)

    def _step_direction(self, step):
        if len(self.directions) <= 1:
            return
        diridx = (self.directions.index(self.direction) + step) % len(self.directions)
        self.direction = self.directions[diridx]
        x, y, yw, l, p = self._load_current()
        self.plot(x, y, yw, self.frametitle, ax_labels=[self.xlabel, self.ylabel], plot_labels=l, isphase=p)
        self.set_plot_window_title(self.frametitle)

    def _antiter_next_button_event(self):
        self._step_antenna(1)

    def _antiter_prev_button_event(self):
        self._step_antenna(-1)

    def _diriter_next_button_event(self):
        self._step_direction(1)

    def _diriter_prev_button_event(self):
        self._step_direction(-1)

    def _set_slot(self, slot):
        """ Show the given frequency slot (when plotting against time) or time slot (when plotting against frequency).

        Args:
            slot (int): index along the frequency or time axis.
        """
        plot_vs_time = 'time' in self.xlabel.lower()
        slot_values = self.frequencies if plot_vs_time else self.times
        if slot_values is None or len(slot_values) == 0:
            return
        slot = max(0, min(slot, len(slot_values) - 1))
        if plot_vs_time:
            self.freqslot = slot
            self.select_label.setText('Frequency: {:.3f} MHz'.format(slot_values[slot] / 1e6))
        else:
            self.timeslot = slot
            self.select_label.setText('Time: ' + self.format_time(slot_values[slot]))
        self.button_prev.setEnabled(slot > 0)
        self.button_next.setEnabled(slot < len(slot_values) - 1)
        # Keep the scrollbar in sync without triggering a second redraw.
        self.scrollbar.blockSignals(True)
        self.scrollbar.setValue(slot)
        self.scrollbar.blockSignals(False)
        x, y, yw, l, p = self._load_current()
        self.plot(x, y, yw, self.frametitle, ax_labels=[self.xlabel, self.ylabel], plot_labels=l, isphase=p)

    def _current_slot(self):
        return self.freqslot if 'time' in self.xlabel.lower() else self.timeslot

    def _forward_button_event(self):
        """ An event triggered by pressing the "Forward" button of a GraphWindow.

        When pressed, the abscissa is advanced one position, showing the next time or frequency slot.
        """
        self._set_slot(self._current_slot() + 1)

    def _backward_button_event(self):
        """ An event triggered by pressing the "Back" button of a GraphWindow.

        When pressed, the abscissa is set back one position, showing the previous time or frequency slot.
        """
        self._set_slot(self._current_slot() - 1)

    def _scrollbar_event(self):
        self._set_slot(self.scrollbar.value())

    def _diff_enabled(self):
        return ('time' in self.xlabel and self.do_timediff) or ('freq' in self.xlabel and self.do_freqdiff)

    def _plot_trace(self, xaxis, values, weights, color, label=None):
        """ Plot one trace, marking flagged points in red.

        Time or frequency differences are applied first when enabled.

        Args:
            xaxis (ndarray): abscissa.
            values (ndarray): values to plot.
            weights (ndarray): weights of the values; zero means flagged.
            color (str): matplotlib color of the trace.
            label (str or None): legend label of the trace.
        """
        v_m = np.ma.masked_where(weights == 0, values)
        if self._diff_enabled():
            v_m = np.ma.diff(v_m, axis=0)
            xaxis = xaxis[:-1]
            weights = weights[:-1]
            if self.st.getType() == 'phase':
                v_m = wrap_phase(v_m)
        self.ax.plot(xaxis, v_m, '--', alpha=0.25, color=color)
        self.ax.plot(xaxis, v_m, 'h', label=label, color=color)
        if np.ma.is_masked(v_m):
            for x in xaxis[weights == 0]:
                self.ax.axvline(x, color='r')
            mask = np.ma.getmaskarray(v_m)
            self.ax.plot(xaxis[mask], np.ma.getdata(v_m)[mask], 'h', color='r')

    def plot(self, xaxis, yaxis, yaxis_weight, frametitle='', limits=(None, None), ax_labels=('', ''), plot_labels=(), multidim=False, isphase=False, legend_loc=None):
        self.xlabel = ax_labels[0]
        self.ylabel = ax_labels[1]
        self.fig.clf()
        self.ax = self.fig.add_subplot(111)
        self.ax.clear()
        self.selected_regions = []
        self.selection_patches = []
        if 'time' in ax_labels[0]:
            # Start counting from t=0
            xaxis = xaxis - xaxis[0]
        self.plot_axis = np.asarray(xaxis)
        if self.rectangle_selector is not None:
            self.rectangle_selector.disconnect_events()
        self.rectangle_selector = RectangleSelector(self.ax, self._on_region_selected, useblit=True, button=[1], spancoords='data', interactive=True)
        self.rectangle_selector.set_active(self.mark_region_button.isChecked())
        self.selected_region = None
        self.flag_button.setEnabled(False)
        self.ax.set_title(frametitle + ' - {:s}'.format(self.direction))
        if 'time' in ax_labels[0] and self.do_timediff:
            self.ax.set_title(frametitle + ' - {:s} time diff'.format(self.direction))
        if 'freq' in ax_labels[0] and self.do_freqdiff:
            self.ax.set_title(frametitle + ' - {:s} frequency diff'.format(self.direction))
        xaxis = np.asarray(xaxis)
        yaxis = np.asarray(yaxis)
        # Set weights to 0 for NaN solutions.
        yaxis_weight = np.where(np.isnan(yaxis), 0, np.asarray(yaxis_weight))
        if self.mode == 'weights':
            traces = yaxis_weight if yaxis.ndim > 1 else [yaxis_weight]
            for i, vw in enumerate(traces):
                label = plot_labels[i] if yaxis.ndim > 1 else None
                self.ax.plot(xaxis, vw, '--', alpha=0.25, color='C' + str(i))
                self.ax.plot(xaxis, vw, 'h', label=label, color='C' + str(i))
        elif yaxis.ndim > 1 and self.do_poldiff:
            pol_a, pol_b = (0, -1) if self.poldifmode == PoldifMode.PARALLEL else (1, 2)
            # A difference is only valid where both polarisations are unflagged.
            self._plot_trace(xaxis, yaxis[pol_a] - yaxis[pol_b], yaxis_weight[pol_a] * yaxis_weight[pol_b], 'C0',
                             label='{} - {}'.format(plot_labels[pol_a], plot_labels[pol_b]))
        elif yaxis.ndim > 1:
            for i in range(yaxis.shape[0]):
                self._plot_trace(xaxis, yaxis[i], yaxis_weight[i], 'C' + str(i), label=plot_labels[i])
        else:
            self._plot_trace(xaxis, yaxis, yaxis_weight, 'C0')
        if yaxis.ndim > 1:
            self.ax.legend()
        x_limits = limits[0]
        y_limits = limits[1]
        if self.mode == 'values' and self.parent is not None:
            global_limits = self.parent.get_global_limits()
            if global_limits is not None:
                y_limits = [global_limits[0], global_limits[1]]
        if isphase and y_limits is None:
            y_limits = [-np.pi, np.pi]
        if x_limits is None and len(xaxis) > 0:
            valid_weights = np.asarray(yaxis_weight) != 0
            valid_values = np.isfinite(np.asarray(yaxis))
            valid_points = valid_weights & valid_values
            if valid_points.ndim > 1:
                valid_points = np.any(valid_points, axis=0)
            if np.any(valid_points):
                visible_xaxis = np.asarray(xaxis)[valid_points]
                x_min = visible_xaxis.min()
                x_max = visible_xaxis.max()
            else:
                x_min = xaxis[0]
                x_max = xaxis[-1]
            x_span = x_max - x_min
            x_padding = 0.02 * x_span if x_span else 0.02
            x_limits = [x_min - x_padding, x_max + x_padding]
        if legend_loc is not None:
            legend = self.ax.get_legend()
            if legend is not None:
                legend._loc = legend_loc
        self.ax.set(xlabel=ax_labels[0], ylabel=ax_labels[1], xlim=x_limits, ylim=y_limits)
        self.canvas.draw_idle()


class ColormapComboBox(QComboBox):
    """Combo box that shows unprefixed names only while its popup is open."""
    def set_prefixed_labels(self, prefixed):
        for index in range(self.count()):
            colormap_name = self.itemData(index)
            label = colormap_name or 'Default'
            self.setItemText(index, 'Cmap: ' + label if prefixed else label)

    def showPopup(self):
        self.set_prefixed_labels(False)
        super().showPopup()

    def hidePopup(self):
        super().hidePopup()
        self.set_prefixed_labels(True)


class GraphWindow2D(PlotWindowBase):
    """ A window displaying the plotted 2D quantity. Allows the user to cycle through antenna.
    """
    def __init__(self, values, weights, frametitle, antindex, refantindex, axis, st, polslot=0, direction=0, times=None, freqs=None, pols=None, parent=None, mode='values', do_timediff=False, do_freqdiff=False, do_poldiff=False, poldifmode=PoldifMode.NONE):
        """ Initialize a new GraphWindow instance.

        Args:
            values (ndarray): array of values to plot.
            weights (ndarray): array of weights corresponding to the values.
            frametitle (str): title the frame will have.
            antindex (int): the index of the selected antenna.
            polslot (int): index along the polarization axis to start with.
            direction (int): index of the direction to plot.
            parent (QDialog): parent window instance.
        Returns:

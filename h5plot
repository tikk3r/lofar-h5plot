    def _pdiff_event(self):
        if self.check_pdiff.isChecked():
            self.check_pdiffx.setChecked(False)
            self.poldifmode = PoldifMode.PARALLEL
            self.do_poldiff = True
            self.logger.debug("Switched to parallel hand poldif")
        elif not self.check_pdiff.isChecked():
            self.do_poldiff = False

    def _pdiffx_event(self):
        if self.check_pdiffx.isChecked():
            self.check_pdiff.setChecked(False)
            self.poldifmode = PoldifMode.CROSS
            self.do_poldiff = True
            self.logger.debug("Switched to cross hand poldif")
        elif not self.check_pdiffx.isChecked():
            self.do_poldiff = False

    def _first_unflagged_station(self):
        """Return ST001 when valid, otherwise the first station with valid data."""
        ant_axis = self.stcache.axes.index('ant')
        station_weights = np.moveaxis(self.stcache.weights, ant_axis, 0)
        has_valid_data = np.any(
            np.isfinite(station_weights) & (station_weights > 0),
            axis=tuple(range(1, station_weights.ndim)))

        station_names = [station.decode('utf-8') if isinstance(station, bytes) else station for station in self.stations]
        if 'ST001' in station_names:
            st001_index = station_names.index('ST001')
            if has_valid_data[st001_index]:
                return self.stations[st001_index]

        valid_indices = np.flatnonzero(has_valid_data)
        if len(valid_indices) > 0:
            return self.stations[valid_indices[0]]
        return self.stations[0]

    def _update_poldiff_controls(self):
        pol_count = self.soltab.getAxisLen('pol') if 'pol' in self.soltab.getAxesNames() else 0

        parallel_enabled = pol_count == 2
        cross_enabled = pol_count == 4
        if not parallel_enabled and self.check_pdiff.isChecked():
            self.check_pdiff.setChecked(False)
        if not cross_enabled and self.check_pdiffx.isChecked():
            self.check_pdiffx.setChecked(False)
        self.check_pdiff.setVisible(parallel_enabled)
        self.check_pdiffx.setVisible(cross_enabled)

    def _axis_picker_event(self):
        """Callback function for when the x-axis is changed.

        Sets the `axis` attribute to the selected axis
        """
        self.logger.debug('Axis changed to: ' + self.axis_picker.currentText())
        self.axis = self.axis_picker.currentText()
        if self.axis != 'waterfall':
            self.plot_all_button.setEnabled(False)
            self.plot_nxm_button.setEnabled(False)
            self.rows_label.setEnabled(False)
            self.rows_spinbox.setEnabled(False)
            self.columns_label.setEnabled(False)
            self.columns_spinbox.setEnabled(False)
        else:
            self.plot_all_button.setEnabled(True)
            self.plot_nxm_button.setEnabled(True)
            self.rows_label.setEnabled(True)
            self.rows_spinbox.setEnabled(True)
            self.columns_label.setEnabled(True)
            self.columns_spinbox.setEnabled(True)

    def closeEvent(self, event):
        """ The event triggerd upon closing the main application window.
        """
        self.logger.info('Closing all open figures before exiting.')
        plt.close('all')
        for f in self.figures:
            f.close()
        # With "Overwrite input" both refer to the same, already closed file.
        for h5 in (self.flagged_h5parm, self.h5parm):
            if h5 is not None:
                try:
                    h5.close()
                except Exception:
                    pass
        event.accept()

    def _refant_picker_event(self):
        """ An even triggered when a new reference antenna is selected.

        Sets the `refant` attribute.
        """
        self.logger.debug('Reference antenna changed to: ' + self.refant_picker.currentText())
        self.refant = self.refant_picker.currentText()

    def _solset_picker_event(self):
        """Callback function for when the SolSet is changed.

        Sets the `solset` attribute.
        """
        solset_prev = self.solset.name
        self.solset = self.h5parm.getSolset(self.solset_picker.currentText())
        if self.solset.name == solset_prev:
            self.logger.debug("Solset unchanged, not reordering")
            return
        self.logger.debug('Solset changed to: ' + self.solset_picker.currentText())
        self.soltab_labels = self.solset.getSoltabNames()
        self.soltab_picker.clear()
        for l in self.soltab_labels:
            self.soltab_picker.addItem(l)
        self._soltab_picker_event()

    def _soltab_picker_event(self):
        """Callback function for when the SolTab is changed.

        Sets the `soltab` attribute.
        """
        self.soltab = self.solset.getSoltab(self.soltab_picker.currentText())
        self.soltab_axes = list(self.soltab.getAxesNames())
        self._update_poldiff_controls()
        # Compare the solset too: soltabs in different solsets often share a name.
        if (self.solset.name, self.soltab.name) == self.loaded_soltab:
            self.logger.debug("Soltab unchanged, not reordering")
            return
        self.logger.debug('Soltab changed to: ' + self.soltab_picker.currentText())
        stations_old = self.stations
        directions_old = self.directions
        self._load_axis_values()
        if not np.array_equiv(stations_old, self.stations):
            self.logger.debug('Number of stations changed, updating list.')
            # The list of stations has changed, update the list.
            self.station_picker.clear()
            self.station_picker.addItems(self.stations)
            self.station_picker.setCurrentRow(0)
            self.refant_picker.clear()
            self.refant_picker.addItems(self.stations)
        if directions_old != self.directions:
            self.logger.debug('Directions changed, updating list.')
            self.dir_picker.clear()
            self.dir_picker.addItems(self.directions)
            self.direction = 0
        self._load_soltab()
        self.refant = self._first_unflagged_station()
        self.refant_picker.setCurrentIndex(np.flatnonzero(self.stations == self.refant)[0])
        self._update_global_limit_defaults()

    def _load_axis_values(self):
        """Read the station, time, frequency, polarization and direction axes of the current soltab.

        Axes the soltab does not have are set to `None`.
        """
        axes = self.soltab.getAxesNames()

        def axis_values(name):
            return self.soltab.getAxisValues(name) if name in axes else None

        self.stations = axis_values('ant')
        self.times = axis_values('time')
        self.frequencies = axis_values('freq')
        self.polarizations = axis_values('pol')
        if 'dir' in axes:
            # Use the soltab's own direction order, as the direction index is applied to its dir axis.
            self.directions = list(axis_values('dir'))
        else:
            self.directions = [self._decode_axis_label(s) for s in self.solset.getSou().keys()]

    def _load_soltab(self):
        """ Read the values and weights of the current soltab into the cache, in the axis order the plots expect. """
        with busy(self.status_label, 'Loading {}/{}, please wait...'.format(self.solset.name, self.soltab.name)):
            rvals, rweights, raxes = reorder_soltab(self.soltab)
        if self.stcache is None:
            self.stcache = SoltabCache(rvals, raxes, weights=rweights)
        else:
            self.stcache.update(rvals, raxes, weights=rweights)
        self.loaded_soltab = (self.solset.name, self.soltab.name)


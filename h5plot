def get_colormap(name):
    if name == _CET_C6_CMAP.name:
        return _CET_C6_CMAP
    if cmaps is not None and hasattr(cmaps, name):
        return getattr(cmaps, name)
    return matplotlib.colormaps[name]


def get_selector_background(selector):
    """ Return the saved blit background of a matplotlib selector widget, or None.

    Matplotlib >= 3.10 keeps it on the canvas, older versions in the `background` attribute.
    """
    if hasattr(selector, '_load_blit_background'):
        return selector._load_blit_background()
    return getattr(selector, 'background', None)


def set_selector_background(selector, background):
    """ Replace the saved blit background of a matplotlib selector widget. Returns False if that is not possible. """
    if hasattr(selector, '_save_blit_background'):
        selector._save_blit_background(background)
        return True
    if hasattr(selector, 'background'):
        selector.background = background
        return True
    return False


def get_phase_colormap():
    return get_colormap('hsv')


@functools.lru_cache(maxsize=None)
def get_colormap_names():
    names = set(matplotlib.colormaps)
    if cmaps is not None:
        if isinstance(cmaps, types.ModuleType):
            names.update(
                name for name in dir(cmaps)
                if not name.startswith('_')
                and isinstance(getattr(cmaps, name), matplotlib.colors.Colormap))
        else:
            # dir() lists the colormap names without loading them. Loading and registering all of
            # them (getattr) takes many seconds. The class attributes are methods, not colormaps.
            names.update(
                name for name in dir(cmaps)
                if not name.startswith('_') and not hasattr(type(cmaps), name))
    names.add(_CET_C6_CMAP.name)
    return tuple(sorted(names, key=lambda name: (name.casefold(), name)))



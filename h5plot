    def _toggle_region_selection(self, enabled):
        if self.rectangle_selector is not None:
            self.rectangle_selector.set_active(enabled)
        for selector in self.grid_rectangle_selectors.values():
            selector.set_active(enabled)
        if not enabled:
            self.selected_region = None
            self.selected_regions = []
            self.grid_pending_regions = {}
            for patch in self.selection_patches:
                patch.remove()
            self.selection_patches = []
            self.flag_button.setEnabled(False)
            self.canvas.draw_idle()

    def _on_region_press(self, event):
        if event.xdata is None or event.ydata is None or event.inaxes is None:
            return
        if self.gridplot:
            for station_index, selector in self.grid_rectangle_selectors.items():
                if selector.ax == event.inaxes:
                    pending = self.grid_pending_regions.get(station_index)
                    if pending is None:
                        return
                    x_start, x_end, y_start, y_end = selector.extents
                    if min(x_start, x_end) <= event.xdata <= max(x_start, x_end) and min(y_start, y_end) <= event.ydata <= max(y_start, y_end):
                        return
                    self.selected_regions.append((station_index, pending))
                    self.selection_patches.append(selector.ax.add_patch(Rectangle(
                        (min(x_start, x_end), min(y_start, y_end)),
                        abs(x_end - x_start),
                        abs(y_end - y_start),
                        fill=False,
                        edgecolor='red')))
                    self.grid_pending_regions[station_index] = None
                    self.canvas.draw_idle()
                    return
        else:
            if event.inaxes is not self.ax or self.selected_region is None or self.rectangle_selector is None:
                return
            x_start, x_end, y_start, y_end = self.rectangle_selector.extents
            if min(x_start, x_end) <= event.xdata <= max(x_start, x_end) and min(y_start, y_end) <= event.ydata <= max(y_start, y_end):
                return
            self.selected_regions.append(self.selected_region)
            self.selection_patches.append(self.ax.add_patch(Rectangle(
                (min(x_start, x_end), min(y_start, y_end)),
                abs(x_end - x_start),
                abs(y_end - y_start),
                fill=False,
                edgecolor='red')))
            self.selected_region = None
            self.canvas.draw_idle()

    def _on_region_selected(self, start_event, end_event):
        if start_event.xdata is None or start_event.ydata is None or end_event.xdata is None or end_event.ydata is None:
            return
        time_low = min(start_event.xdata, end_event.xdata)
        time_high = max(start_event.xdata, end_event.xdata)
        freq_low = min(start_event.ydata, end_event.ydata)
        freq_high = max(start_event.ydata, end_event.ydata)

        # imshow spreads the array cells between the first and last extent
        # values. Search those cell edges rather than the solution centers.
        time_edges = np.linspace(self.plot_time_axis[0], self.plot_time_axis[-1], len(self.plot_time_axis) + 1)
        freq_edges = np.linspace(self.plot_freq_axis[0], self.plot_freq_axis[-1], len(self.plot_freq_axis) + 1)
        time_start = int(np.searchsorted(time_edges, time_low, side='right') - 1)
        time_stop = int(np.searchsorted(time_edges, time_high, side='left'))
        freq_start = int(np.searchsorted(freq_edges, freq_low, side='right') - 1)
        freq_stop = int(np.searchsorted(freq_edges, freq_high, side='left'))
        time_start = max(0, min(time_start, len(self.plot_time_axis) - 1))
        time_stop = max(0, min(time_stop, len(self.plot_time_axis)))
        freq_start = max(0, min(freq_start, len(self.plot_freq_axis) - 1))
        freq_stop = max(0, min(freq_stop, len(self.plot_freq_axis)))
        self.selected_region = (time_start, time_stop, freq_start, freq_stop)
        self.selected_station_index = self.antindex
        self.flag_button.setEnabled(True)

    def _on_grid_region_selected(self, start_event, end_event, station_index):
        if start_event.xdata is None or start_event.ydata is None or end_event.xdata is None or end_event.ydata is None:
            return
        time_edges = np.linspace(self.grid_time_axis[0], self.grid_time_axis[-1], len(self.grid_time_axis) + 1)
        freq_edges = np.linspace(self.grid_freq_axis[0], self.grid_freq_axis[-1], len(self.grid_freq_axis) + 1)
        time_start = int(np.searchsorted(time_edges, min(start_event.xdata, end_event.xdata), side='right') - 1)
        time_stop = int(np.searchsorted(time_edges, max(start_event.xdata, end_event.xdata), side='left'))
        freq_start = int(np.searchsorted(freq_edges, min(start_event.ydata, end_event.ydata), side='right') - 1)
        freq_stop = int(np.searchsorted(freq_edges, max(start_event.ydata, end_event.ydata), side='left'))
        time_start = max(0, min(time_start, len(self.grid_time_axis) - 1))
        time_stop = max(0, min(time_stop, len(self.grid_time_axis)))
        freq_start = max(0, min(freq_start, len(self.grid_freq_axis) - 1))
        freq_stop = max(0, min(freq_stop, len(self.grid_freq_axis)))
        if time_start < time_stop and freq_start < freq_stop:
            region = (time_start, time_stop, freq_start, freq_stop)
            self.grid_pending_regions[station_index] = region
            self.selected_station_index = station_index
            self.flag_button.setEnabled(True)

    def _flag_selected_region(self):
        self._update_selected_region_weights(0.0)

    def _update_selected_region_weights(self, weight):
        direction_index = self.parent.directions.index(self.direction)
        if self.gridplot:
            regions = list(self.selected_regions)
            for station_idx, pending in self.grid_pending_regions.items():
                if pending is not None:
                    regions.append((station_idx, pending))
            if not regions:
                return
            for antenna_index, region in regions:
                self.parent.update_waterfall_weights(region, antenna_index, self.polslot, direction_index, weight, self.propagate_directions.isChecked(), self.propagate_polarizations.isChecked(), self.propagate_antennas.isChecked(), dialog_parent=self)
        else:
            regions = list(self.selected_regions)
            if self.selected_region is not None:
                regions.append(self.selected_region)
            if not regions:
                return
            for region in regions:
                self.parent.update_waterfall_weights(region, self.antindex, self.polslot, direction_index, weight, self.propagate_directions.isChecked(), self.propagate_polarizations.isChecked(), self.propagate_antennas.isChecked(), dialog_parent=self)
        self.selected_region = None
        self.selected_regions = []
        self.grid_pending_regions = {}
        for patch in self.selection_patches:
            patch.remove()
        self.selection_patches = []
        self.flag_button.setEnabled(False)
        if self.gridplot:
            if self.nxm_dimensions is None:
                self.plot_all()
            else:
                self.plot_nxm(*self.nxm_dimensions)
        else:
            self._refresh_current_plot()

    def _flag_all_points(self):
        if self.gridplot:
            region = (0, len(self.grid_time_axis), 0, len(self.grid_freq_axis))
            self.parent.update_waterfall_weights(region, self.selected_station_index, self.polslot, self.parent.directions.index(self.direction), 0.0, self.propagate_directions.isChecked(), self.propagate_polarizations.isChecked(), self.propagate_antennas.isChecked(), dialog_parent=self)
            self.selected_region = None
            self.selected_regions = []
            self.grid_pending_regions = {}
            for patch in self.selection_patches:
                patch.remove()
            self.selection_patches = []
            self.flag_button.setEnabled(False)
            if self.nxm_dimensions is None:
                self.plot_all()
            else:
                self.plot_nxm(*self.nxm_dimensions)
            return
        x_limits = self.ax.get_xlim()
        y_limits = self.ax.get_ylim()
        direction_index = self.parent.directions.index(self.direction)
        region = (0, len(self.plot_time_axis), 0, len(self.plot_freq_axis))
        self.parent.update_waterfall_weights(region, self.antindex, self.polslot, direction_index, 0.0, self.propagate_directions.isChecked(), self.propagate_polarizations.isChecked(), self.propagate_antennas.isChecked(), dialog_parent=self)
        self.selected_region = None
        self.selected_regions = []
        self.grid_pending_regions = {}
        for patch in self.selection_patches:
            patch.remove()
        self.selection_patches = []
        self.flag_button.setEnabled(False)
        self._refresh_current_plot()

    def _refresh_current_plot(self):
        self.weights = self.parent.stcache.weights
        x_limits = self.ax.get_xlim()
        y_limits = self.ax.get_ylim()
        direction_index = self.parent.directions.index(self.direction)
        x, y, z, zw, isphase = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, self.polslot, direction=direction_index)
        if self.mode == 'values':
            self.plot(x, y, np.where(zw, z, np.nan), self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'), isphase=isphase)
        else:
            self.plot(x, y, zw, self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'))
        self.ax.set_xlim(x_limits)
        self.ax.set_ylim(y_limits)
        self.canvas.draw()

    def format_time(self, seconds):
        """ Formats the time to be displayed in the plotting windows.

        A string is formatted, displaying the time in seconds or (fractional) minutes or hours.

        Args:
            seconds (int): the time in seconds.
        Returns:
            formatted time (str): formatted time string.
        """
        if seconds < 60:
            return '{:.3f} sec'.format(seconds)
        elif 60 <= seconds < 3600:
            return '{:.3f} min'.format(seconds / 60)
        elif seconds >= 3600:
            return '{:.3f} hr'.format(seconds / 3600)
        else:
            return '{:.3f}'.format(seconds)

    def _navigate_nxm_group(self, step):
        if self.nxm_dimensions is None:
            return False
        ncols, nrows = self.nxm_dimensions
        group_size = ncols * nrows
        last_station = len(self.parent.stations) - 1
        self.antindex = max(0, min(self.antindex + step * group_size, last_station))
        self.frametitle = self.parent.stations[self.antindex]
        self.plot_nxm(ncols, nrows)
        self.set_plot_window_title(self.frametitle)
        return True

    def _antiter_next_button_event(self):
        if self._navigate_nxm_group(1):
            return
        if (self.antindex + 1) < len(self.parent.stations):
            self.antindex += 1
        else:
            self.antindex = 0
        diridx = self.parent.directions.index(self.direction)
        if len(self.polarizations) > 1 and self.do_poldiff:
            if self.poldifmode == PoldifMode.PARALLEL:
                # Need to plot polarisation difference.
                x, y, z1, zw1, p = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, 0, direction=diridx)
                x2, y2, z2, zw2, p2 = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, -1, direction=diridx)
            elif self.poldifmode == PoldifMode.CROSS:
                # Need to plot polarisation difference.
                x, y, z1, zw1, p = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, 1, direction=diridx)
                x2, y2, z2, zw2, p2 = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, 2, direction=diridx)
            z = z1 - z2
            # Combine flags of both polarisations.
            zw = zw1 * zw2
        else:
            x, y, z, zw, p = load_axes_2d(self.values, self.weights, self.st, self.antindex, self.refantindex, self.polslot, direction=diridx)
        self.frametitle = self.parent.stations[self.antindex]
        if self.mode == 'values':
            z = np.where(zw, z, np.nan)
            self.plot(x, y, z, self.frametitle, ax_labels=('Time [s]', 'Freq. [MHz]'), isphase=p)
